@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix arto: <http://www.ub.bw/ontologies/arto#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# ═══════════════════════════════════════════════════════════════════════
# ARTO — M1 Artefact Module
# Middle-out Step 5 (FINAL): MaintenanceArtefact + DefectArtefact
#                             migration + full Sprint module +
#                             documents · addresses RT properties +
#                             M4 SKOS semantic resolution preview
# University of Botswana · PhD Research · Tshepho Koboyatshwene
#
# Imports: arto-m1-step4.ttl (which imports step3 → step2 → step1)
#
# Add to catalog-v001.xml:
#   <uri name="http://www.ub.bw/ontologies/arto/m1-step5"
#        uri="arto-m1-step5.ttl"/>
#
# New SDLC abstract class:
#   arto:MaintenanceArtefact   (SDLC: Maintenance phase)
#
# DefectArtefact migration:
#   DefectArtefact rdfs:subClassOf MaintenanceArtefact
#   (was: rdfs:subClassOf AgileArtefact in Step 1)
#   Single rdfs:subClassOf re-declaration — no property or
#   individual rework required.
#
# New leaf classes under MaintenanceArtefact:
#   arto:Documentation    Issue.Type = 'Documentation' (699)
#   arto:SupportRequest   Issue.Type = 'Support Request' (2,368)
#   arto:BuildFailure     Issue.Type = 'Build Failure' (1,715)
#   arto:ProblemTicket    Issue.Type = 'Problem Ticket' (113)
#
# TechnicalDebt decision:
#   ETL-filtered — 30 individuals, zero RT links in Query 13.
#   Mapped to arto:Improvement via skos:closeMatch in M4
#   semantic resolution section below.
#
# Full Sprint module:
#   arto:Sprint completed with all data properties
#   Source: TAWOS Sprint table (Query 14)
#   ETL filter: WHERE Start_Date IS NOT NULL
#   States: CLOSED · ACTIVE · FUTURE
#
# New RT properties:
#   documents   ← Documentation→AgileArtefact (5 RT links, verified
#                 via direct OUTBOUND-only COUNT, Oct 2026 audit;
#                 supersedes an earlier estimate of 114 that double-
#                 counted both link directions)
#   addresses   ← AgileArtefact→AgileArtefact (22 links, same audit;
#                 supersedes an earlier estimate of 44)
#
# M4 SKOS semantic resolution preview:
#   TechnicalDebt → skos:closeMatch → Improvement
#   SupportRequest → skos:closeMatch → Bug
#   BuildFailure → skos:closeMatch → Bug
#   Investigation → skos:closeMatch → ProblemTicket
#   (EnhancementRequest → skos:exactMatch → Improvement is declared
#    once, in M4; the duplicate formerly here was removed in v1.1.0)
#
# TAWOS grounding evidence (Queries 13-15):
#   Documentation  → 5 RT links (Reference·Duplicate·Relates,
#                    verified via direct OUTBOUND-only COUNT, Oct
#                    2026 audit; supersedes an earlier estimate of 114
#                    that double-counted both link directions)
#   SupportRequest → 154 RT links (Reference·Duplicate·Cause)
#   BuildFailure   → 81 RT links  (Duplicate·Relates)
#   ProblemTicket  → 29 RT links  (Related·Duplicate)
#   Sprint table   → CLOSED·ACTIVE·FUTURE states confirmed
#   Change_Log     → summary(83,599)·description(264,504)·
#                    Link(448,089) confirmed as M4 drift sources
#
# Complete SDLC hierarchy after Step 5:
#   AgileArtefact
#   ├── RequirementsArtefact
#   │   ├── Epic · UserStory · RequirementCandidate
#   │   │   └── Suggestion · Improvement · NewFeature
#   ├── ImplementationArtefact
#   │   ├── SprintTask · CodeCommit
#   ├── TestingArtefact
#   │   ├── TestCase · TestResult
#   ├── DesignArtefact
#   │   ├── ArchitectureDocument · DesignModel · Prototype
#   ├── DeploymentArtefact
#   │   ├── Version · PlannedRelease
#   └── MaintenanceArtefact        ← NEW
#       ├── DefectArtefact         ← MIGRATED from AgileArtefact
#       │   └── Bug
#       ├── Documentation          ← NEW
#       ├── SupportRequest         ← NEW
#       ├── BuildFailure           ← NEW
#       └── ProblemTicket          ← NEW
#   OrphanArtefact                 (cross-cutting)
#   Event
#   └── Sprint                     ← COMPLETED
#
# Load into Protégé 4.3:
#   File → Open → arto-m1-pilot-step5.ttl (updated pilot)
#   Protégé resolves: pilot → step5 → step4 → step3 → step2 → step1
#   Reasoner → HermiT → Start reasoner
#   Expected: 30 satisfiable classes, 0 unsatisfiable
#   Verify: DefectArtefact nested under MaintenanceArtefact
#           Sprint properties visible in Data Properties tab
# ═══════════════════════════════════════════════════════════════════════

<http://www.ub.bw/ontologies/arto/m1-step5>
    a owl:Ontology ;
    rdfs:label "ARTO M1 Step 5"@en ;
    rdfs:comment "ARTO M1 Artefact Module — Step 5 (FINAL): MaintenanceArtefact, DefectArtefact migration, full Sprint module, documents and addresses RT properties, M4 SKOS semantic resolution preview."@en ;
    owl:imports <http://www.ub.bw/ontologies/arto/m1-step4> ;
    owl:versionInfo "1.1.0 — step 5 final: MaintenanceArtefact + Sprint + SKOS. v1.1.0: skos:exactMatch/closeMatch declared as object properties (previously read as annotations by Protégé 4.3, which blocked SWRL R3); duplicate Improvement exactMatch EnhancementRequest removed (kept in M4)" .


# ═══════════════════════════════════════════════════════════════════════
# DEFECTARTEFACT MIGRATION
# Re-declares DefectArtefact with MaintenanceArtefact as parent.
# Supersedes the Step 1 declaration (AgileArtefact as parent).
# No property or individual rework required — Bug inherits
# the new parent automatically.
# Disjointness updated to reflect new position in hierarchy.
# ═══════════════════════════════════════════════════════════════════════

arto:DefectArtefact
    rdfs:subClassOf arto:MaintenanceArtefact ;
    rdfs:comment "MIGRATED in Step 5: DefectArtefact now SubClassOf MaintenanceArtefact (was SubClassOf AgileArtefact in Step 1). Defect management is a maintenance-phase activity. Single rdfs:subClassOf re-declaration — no property or individual rework required. Bug inherits new parent automatically."@en .


# ═══════════════════════════════════════════════════════════════════════
# SPRINT MODULE — FULL DATA PROPERTIES
# Completes the Sprint class introduced in Step 4 (Time Indexed Situation
# ODP anchor, arto:Event).
# Source: TAWOS Sprint table (Query 14)
# ETL filter: WHERE Start_Date IS NOT NULL
# ═══════════════════════════════════════════════════════════════════════

arto:sprintId
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sprint ID"@en ;
    rdfs:comment "TAWOS: Sprint.ID (Int). Primary key. Uniquely identifies a Sprint individual."@en ;
    rdfs:domain arto:Sprint ;
    rdfs:range xsd:integer .

arto:jiraSprintId
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "Jira sprint ID"@en ;
    rdfs:comment "TAWOS: Sprint.Jira_ID (Int). The Jira-internal sprint identifier. Preserved for cross-project sprint matching in M4."@en ;
    rdfs:domain arto:Sprint ;
    rdfs:range xsd:integer .

arto:sprintName
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sprint name"@en ;
    rdfs:comment "TAWOS: Sprint.Name (String). Human-readable sprint name e.g. 'Sprint 12', 'GDPR Followup Sprint 1'. Names vary widely across projects — ETL preserves raw value for M4 drift analysis."@en ;
    rdfs:domain arto:Sprint ;
    rdfs:range xsd:string .

arto:sprintState
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sprint state"@en ;
    rdfs:comment "TAWOS: Sprint.State (String). Confirmed values from Query 14: CLOSED · ACTIVE · FUTURE. ETL filter: WHERE Start_Date IS NOT NULL excludes virtual sprints (Kanban boards, version-named backlogs)."@en ;
    rdfs:domain arto:Sprint ;
    rdfs:range xsd:string .

arto:startDate
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "start date"@en ;
    rdfs:comment "TAWOS: Sprint.Start_Date (DateTime). Sprint start. Together with endDate, realises the Time Indexed Situation pattern's time interval as plain data properties rather than a separate TimeInterval class. ETL filter: WHERE Start_Date IS NOT NULL."@en ;
    rdfs:domain arto:Sprint ;
    rdfs:range xsd:dateTime .

arto:endDate
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "end date"@en ;
    rdfs:comment "TAWOS: Sprint.End_Date (DateTime). Planned sprint end date. May differ from Complete_Date for overrun sprints."@en ;
    rdfs:domain arto:Sprint ;
    rdfs:range xsd:dateTime .

arto:activatedDate
    a owl:DatatypeProperty ;
    rdfs:label "activated date"@en ;
    rdfs:comment "TAWOS: Sprint.Activated_Date (DateTime). When the sprint was formally started. NULL for some sprints — optional property."@en ;
    rdfs:domain arto:Sprint ;
    rdfs:range xsd:dateTime .

arto:completeDate
    a owl:DatatypeProperty ;
    rdfs:label "complete date"@en ;
    rdfs:comment "TAWOS: Sprint.Complete_Date (DateTime). When the sprint was formally closed. Only populated for CLOSED sprints. Key property for velocity and throughput analysis."@en ;
    rdfs:domain arto:Sprint ;
    rdfs:range xsd:dateTime .

arto:sprintProjectId
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sprint project ID"@en ;
    rdfs:comment "TAWOS: Sprint.Project_ID (Int). Foreign key to Project table. Links sprint to one of the 39 TAWOS projects."@en ;
    rdfs:domain arto:Sprint ;
    rdfs:range xsd:integer .


# ═══════════════════════════════════════════════════════════════════════
# SPRINT CARDINALITY RESTRICTIONS AND DISJOINTNESS
# Completes the Sprint class definition started in Step 4.
# Sprint is a time-bounded container (an Event), not an artefact, so it
# is declared disjoint with AgileArtefact: any axiom that would make a
# Sprint an AgileArtefact now surfaces as an inconsistency instead of a
# silent inference.
# ═══════════════════════════════════════════════════════════════════════

arto:Sprint
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:sprintId ;
          owl:cardinality 1 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:sprintName ;
          owl:cardinality 1 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:sprintState ;
          owl:cardinality 1 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:sprintProjectId ;
          owl:cardinality 1 ] ;

    owl:disjointWith arto:AgileArtefact ;

    owl:hasKey ( arto:sprintId ) .


# ═══════════════════════════════════════════════════════════════════════
# SPRINT BRIDGE PROPERTY
# belongsToSprint — connects UserStory/SprintTask to Sprint
# Core M3 bridge property — CQ1 and CQ7 sprint context
# TAWOS: Issue.Sprint_ID (Int) → Sprint.ID
# Deliberately NOT a subproperty of hasTraceLink: sprint membership is
# not a trace link between artefacts, and hasTraceLink has range
# AgileArtefact, so a subproperty ranging over Sprint would entail that
# every Sprint is an AgileArtefact (see the Sprint disjointness axiom
# below).
# ═══════════════════════════════════════════════════════════════════════

arto:belongsToSprint
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "belongs to sprint"@en ;
    rdfs:comment "Links a UserStory or SprintTask to the Sprint it is assigned to. TAWOS: Issue.Sprint_ID (Int) foreign key. Functional — TAWOS records a single Sprint_ID per issue, so an artefact has at most one belongsToSprint assertion; carry-over across sprints is represented through BacklogItems (an artefact can appear as a BacklogItem in several sprints), not through additional belongsToSprint assertions. Core M3 bridge property enabling CQ1 sprint context queries and CQ7 sprint velocity analysis. Deliberately NOT a subproperty of hasTraceLink: sprint membership is not a trace link between artefacts, and because hasTraceLink has range AgileArtefact, a subproperty ranging over Sprint would entail that every Sprint is an AgileArtefact, contradicting Sprint's position under Event, outside the AgileArtefact subtree."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range arto:Sprint .

arto:hasMember
    a owl:ObjectProperty ;
    rdfs:label "has member"@en ;
    rdfs:comment "Inverse of arto:belongsToSprint. A Sprint has one or more AgileArtefact members. Inferred by HermiT — not asserted in ETL."@en ;
    rdfs:domain arto:Sprint ;
    rdfs:range arto:AgileArtefact ;
    owl:inverseOf arto:belongsToSprint .


# ═══════════════════════════════════════════════════════════════════════
# MAINTENANCEARTEFACT-SPECIFIC DATA PROPERTIES
# ═══════════════════════════════════════════════════════════════════════

arto:maintenanceType
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "maintenance type"@en ;
    rdfs:comment "TAWOS: Issue.Type (String). The raw TAWOS maintenance type — Documentation · Support Request · Build Failure · Problem Ticket. Preserved via arto:issueType but typed here for MaintenanceArtefact-specific querying."@en ;
    rdfs:domain arto:MaintenanceArtefact ;
    rdfs:range xsd:string .

arto:resolutionStatus
    a owl:DatatypeProperty ;
    rdfs:label "resolution status"@en ;
    rdfs:comment "TAWOS: Issue.Resolution (String). How this maintenance artefact was resolved. Values vary by type: Documentation → Published/Outdated; SupportRequest → Resolved/Won't Fix; BuildFailure → Fixed/Known Issue."@en ;
    rdfs:domain arto:MaintenanceArtefact ;
    rdfs:range xsd:string .


# ═══════════════════════════════════════════════════════════════════════
# DOCUMENTATION-SPECIFIC DATA PROPERTIES
# ═══════════════════════════════════════════════════════════════════════

arto:documentType
    a owl:DatatypeProperty ;
    rdfs:label "document type"@en ;
    rdfs:comment "The type of documentation artefact e.g. API documentation, user guide, release notes, inline comment. Literature-grounded."@en ;
    rdfs:domain arto:Documentation ;
    rdfs:range xsd:string .

arto:documentUrl
    a owl:DatatypeProperty ;
    rdfs:label "document URL"@en ;
    rdfs:comment "TAWOS: Issue.URL (String). Link to the documentation resource. Optional — not all documentation issues have an external URL."@en ;
    rdfs:domain arto:Documentation ;
    rdfs:range xsd:anyURI .


# ═══════════════════════════════════════════════════════════════════════
# SUPPORTREQUEST-SPECIFIC DATA PROPERTIES
# ═══════════════════════════════════════════════════════════════════════

arto:supportChannel
    a owl:DatatypeProperty ;
    rdfs:label "support channel"@en ;
    rdfs:comment "The channel through which this support request was received e.g. email, forum, helpdesk, community. Literature-grounded."@en ;
    rdfs:domain arto:SupportRequest ;
    rdfs:range xsd:string .

arto:affectedUsers
    a owl:DatatypeProperty ;
    rdfs:label "affected users"@en ;
    rdfs:comment "Number of users affected by this support issue. Literature-grounded. Higher values signal higher priority for bug traceability."@en ;
    rdfs:domain arto:SupportRequest ;
    rdfs:range xsd:integer .


# ═══════════════════════════════════════════════════════════════════════
# BUILDFAILURE-SPECIFIC DATA PROPERTIES
# ═══════════════════════════════════════════════════════════════════════

arto:buildSystem
    a owl:DatatypeProperty ;
    rdfs:label "build system"@en ;
    rdfs:comment "The CI/CD system that generated this build failure e.g. Jenkins, Travis CI, GitHub Actions. Literature-grounded."@en ;
    rdfs:domain arto:BuildFailure ;
    rdfs:range xsd:string .

arto:failedStage
    a owl:DatatypeProperty ;
    rdfs:label "failed stage"@en ;
    rdfs:comment "The pipeline stage at which the build failed e.g. compile, test, package, deploy. Literature-grounded. Connects to TestCase via verifies property when failure is test-related."@en ;
    rdfs:domain arto:BuildFailure ;
    rdfs:range xsd:string .


# ═══════════════════════════════════════════════════════════════════════
# SDLC ABSTRACT CLASS 7: arto:MaintenanceArtefact
# SDLC Phase: Maintenance
# Leaf classes: DefectArtefact (migrated) · Documentation ·
#               SupportRequest · BuildFailure · ProblemTicket
# TechnicalDebt: ETL-filtered → skos:closeMatch → Improvement in M4
# ═══════════════════════════════════════════════════════════════════════

arto:MaintenanceArtefact
    a owl:Class ;
    rdfs:label "Maintenance Artefact"@en ;
    rdfs:comment "Abstract SDLC Maintenance phase class. Groups DefectArtefact (migrated from AgileArtefact), Documentation, SupportRequest, BuildFailure, and ProblemTicket. TAWOS grounding: Documentation (699) · SupportRequest (2,368) · BuildFailure (1,715) · ProblemTicket (113) · Bug (215,570 via DefectArtefact). TechnicalDebt (30 individuals, zero RT links) ETL-filtered — mapped to arto:Improvement via skos:closeMatch in M4. Change_Log table (Query 15) provides M4 drift sources: summary (83,599) · description (264,504) · Link (448,089) change records."@en ;
    rdfs:subClassOf arto:AgileArtefact ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:maintenanceType ;
          owl:minCardinality 0 ] ;

    owl:disjointWith arto:RequirementsArtefact ;
    owl:disjointWith arto:ImplementationArtefact ;
    owl:disjointWith arto:TestingArtefact ;
    owl:disjointWith arto:DesignArtefact ;
    owl:disjointWith arto:DeploymentArtefact .


# ═══════════════════════════════════════════════════════════════════════
# CLASS: arto:Documentation
# SDLC: MaintenanceArtefact → Documentation
# TAWOS: Issue.Type = 'Documentation' (699 individuals)
# RT links: 5 confirmed (Reference·Duplicate·Relates with
#           Bug·Story·Improvement — verified via direct OUTBOUND-only
#           COUNT, Oct 2026 audit; supersedes an earlier estimate of
#           114 that double-counted both link directions)
# ═══════════════════════════════════════════════════════════════════════

arto:Documentation
    a owl:Class ;
    rdfs:label "Documentation"@en ;
    rdfs:comment "A documentation artefact tracking the creation or update of technical or user documentation. TAWOS: Issue.Type = Documentation (699 individuals). RT links confirmed: 5 links (verified via direct OUTBOUND-only COUNT against the live TAWOS database, Oct 2026 audit; supersedes an earlier estimate of 114 that double-counted both link directions) in Reference/Duplicate/Relates with Bug/Story/Improvement. New RT property: documents (Documentation → AgileArtefact)."@en ;
    rdfs:subClassOf arto:MaintenanceArtefact ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:documentType ;
          owl:minCardinality 0 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:documentUrl ;
          owl:minCardinality 0 ] ;

    owl:disjointWith arto:DefectArtefact ;
    owl:disjointWith arto:SupportRequest ;
    owl:disjointWith arto:BuildFailure ;
    owl:disjointWith arto:ProblemTicket .


# ═══════════════════════════════════════════════════════════════════════
# CLASS: arto:SupportRequest
# SDLC: MaintenanceArtefact → SupportRequest
# TAWOS: Issue.Type = 'Support Request' (2,368 individuals)
# RT links: 154 confirmed (highest maintenance volume — Query 13)
# ═══════════════════════════════════════════════════════════════════════

arto:SupportRequest
    a owl:Class ;
    rdfs:label "Support Request"@en ;
    rdfs:comment "A user-reported support or help request. TAWOS: Issue.Type = Support Request (2,368 individuals — highest maintenance volume). RT links: 154 confirmed in Query 13 (Reference/Duplicate/Cause with Suggestion/Bug). Only 4 sprint-assigned — primarily a post-release maintenance artefact."@en ;
    rdfs:subClassOf arto:MaintenanceArtefact ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:supportChannel ;
          owl:minCardinality 0 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:affectedUsers ;
          owl:minCardinality 0 ] ;

    owl:disjointWith arto:DefectArtefact ;
    owl:disjointWith arto:Documentation ;
    owl:disjointWith arto:BuildFailure ;
    owl:disjointWith arto:ProblemTicket .


# ═══════════════════════════════════════════════════════════════════════
# CLASS: arto:BuildFailure
# SDLC: MaintenanceArtefact → BuildFailure
# TAWOS: Issue.Type = 'Build Failure' (1,715 individuals)
# RT links: 81 confirmed (Duplicate with itself + Task — Query 13)
# ═══════════════════════════════════════════════════════════════════════

arto:BuildFailure
    a owl:Class ;
    rdfs:label "Build Failure"@en ;
    rdfs:comment "A CI/CD pipeline build failure tracked as a Jira issue. TAWOS: Issue.Type = Build Failure (1,715 individuals). RT links: 81 confirmed in Query 13 (Duplicate with itself and Task). Zero sprint-assigned — purely a maintenance/operations artefact. Connects to Bug via isCausedBy when build failure introduces a defect."@en ;
    rdfs:subClassOf arto:MaintenanceArtefact ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:buildSystem ;
          owl:minCardinality 0 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:failedStage ;
          owl:minCardinality 0 ] ;

    owl:disjointWith arto:DefectArtefact ;
    owl:disjointWith arto:Documentation ;
    owl:disjointWith arto:SupportRequest ;
    owl:disjointWith arto:ProblemTicket .


# ═══════════════════════════════════════════════════════════════════════
# CLASS: arto:ProblemTicket
# SDLC: MaintenanceArtefact → ProblemTicket
# TAWOS: Issue.Type = 'Problem Ticket' (113 individuals)
# RT links: 29 confirmed (Related/Duplicate with Bug — Query 13)
# ═══════════════════════════════════════════════════════════════════════

arto:ProblemTicket
    a owl:Class ;
    rdfs:label "Problem Ticket"@en ;
    rdfs:comment "A formal problem record tracking a recurring or systemic issue. TAWOS: Issue.Type = Problem Ticket (113 individuals). RT links: 29 confirmed in Query 13 (Related/Duplicate with Bug). Semantically distinct from Bug — a ProblemTicket tracks a systemic pattern while Bug tracks a specific defect instance."@en ;
    rdfs:subClassOf arto:MaintenanceArtefact ;

    owl:disjointWith arto:DefectArtefact ;
    owl:disjointWith arto:Documentation ;
    owl:disjointWith arto:SupportRequest ;
    owl:disjointWith arto:BuildFailure .


# ═══════════════════════════════════════════════════════════════════════
# NEW RT OBJECT PROPERTIES — Step 5
# ═══════════════════════════════════════════════════════════════════════

# ── documents / isDocumentedBy ────────────────────────────────────────
# Evidence: Query 13 — 5 total links (verified via direct
#   OUTBOUND-only COUNT, Oct 2026 audit; supersedes an earlier
#   estimate of 114 that double-counted both link directions; the
#   original per-artefact-type breakdown is not reproduced here as
#   it has not itself been re-verified at this smaller scale)
# Domain: Documentation — only documentation artefacts document others
# Range: AgileArtefact — documentation can cover any artefact type
# New property — not covered by existing Step 2 properties

arto:documents
    a owl:ObjectProperty , owl:AsymmetricProperty ;
    rdfs:label "documents"@en ;
    rdfs:comment "A Documentation artefact formally describes or explains another AgileArtefact. TAWOS: Reference/Duplicate/Relates links between Documentation and Bug/Story/Improvement (5 links, verified via direct OUTBOUND-only COUNT against the live TAWOS database, Oct 2026 audit; supersedes an earlier estimate of 114 that double-counted both link directions). Asymmetric. An ARTO-specific extension beyond the four verified Ramesh and Jarke (2001) categories (Chapter 6, Section 6.5) — no corresponding named sub-type in their taxonomy is claimed."@en ;
    rdfs:domain arto:Documentation ;
    rdfs:range arto:AgileArtefact ;
    rdfs:subPropertyOf arto:hasTraceLink .

arto:isDocumentedBy
    a owl:ObjectProperty ;
    rdfs:label "is documented by"@en ;
    rdfs:comment "Inverse of arto:documents. Inferred by HermiT — not asserted in ETL."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range arto:Documentation ;
    owl:inverseOf arto:documents .


# ── addresses / isAddressedBy ─────────────────────────────────────────
# Evidence: Query 4 — Addresses (22 links, verified via direct
#   OUTBOUND-only COUNT, Oct 2026 audit; supersedes an earlier
#   estimate of 44 that double-counted both link directions)
# Domain: AgileArtefact — any artefact can address a problem
# Range: AgileArtefact — typically SupportRequest or ProblemTicket
# An ARTO-specific extension beyond the four verified Ramesh and
# Jarke (2001) categories — no corresponding named sub-type is claimed

arto:addresses
    a owl:ObjectProperty , owl:AsymmetricProperty ;
    rdfs:label "addresses"@en ;
    rdfs:comment "An AgileArtefact (typically UserStory or SprintTask) addresses a maintenance concern (SupportRequest or ProblemTicket). TAWOS: Addresses link type (22 links, verified via direct OUTBOUND-only COUNT, Oct 2026 audit). Asymmetric. An ARTO-specific extension beyond the four verified Ramesh and Jarke (2001) categories — no corresponding named sub-type is claimed."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range arto:AgileArtefact ;
    rdfs:subPropertyOf arto:hasTraceLink .

arto:isAddressedBy
    a owl:ObjectProperty ;
    rdfs:label "is addressed by"@en ;
    rdfs:comment "Inverse of arto:addresses. Inferred by HermiT — not asserted in ETL."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range arto:AgileArtefact ;
    owl:inverseOf arto:addresses .

# ── follows / isFollowedBy ──────────────────────────────────────────────
# Evidence: Follows link type (25 links) — TAWOS_ETL_Audit query 0.1
# Domain: AgileArtefact — any artefact can sequentially follow another
# Range: AgileArtefact — any artefact type may be the predecessor
# An ARTO-specific extension beyond the four verified Ramesh and
# Jarke (2001) categories — no corresponding named sub-type is claimed
# (planned in Step 4, implemented
# here in Step 5 alongside documents/addresses)

arto:follows
    a owl:ObjectProperty , owl:AsymmetricProperty ;
    rdfs:label "follows"@en ;
    rdfs:comment "An AgileArtefact sequentially follows another AgileArtefact (temporal/logical precedence, distinct from blocks — no hard dependency implied). TAWOS: Follows link type (25 links). Asymmetric. An ARTO-specific extension beyond the four verified Ramesh and Jarke (2001) categories — no corresponding named sub-type is claimed."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range arto:AgileArtefact ;
    rdfs:subPropertyOf arto:hasTraceLink .

arto:isFollowedBy
    a owl:ObjectProperty ;
    rdfs:label "is followed by"@en ;
    rdfs:comment "Inverse of arto:follows. Inferred by HermiT — not asserted in ETL."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range arto:AgileArtefact ;
    owl:inverseOf arto:follows .


# ═══════════════════════════════════════════════════════════════════════
# M4 SEMANTIC RESOLUTION PREVIEW — SKOS MAPPINGS
# Maps ETL-filtered Issue types to nearest ARTO class via SKOS.
# Full M4 module (TermVariant · SynonymCluster · DriftEvent)
# built in the separate M4 ontology file.
# skos:exactMatch and skos:closeMatch are declared below as object
# properties. This file loads before M4, and without these
# declarations Protégé 4.3 (OWL API 3.4.2) read the mappings as
# annotation assertions. That made skos:exactMatch an annotation
# property across the whole network, so SWRL Rule R3 could not match
# exactMatch pairs between pilot individuals.
# The class-level mappings below use OWL 2 punning (the class IRI is
# also read as an individual), which is legal in OWL 2 DL. Those
# punned individuals are not AgileArtefact members, so R3 never fires
# on them.
# ═══════════════════════════════════════════════════════════════════════

skos:exactMatch a owl:ObjectProperty .
skos:closeMatch a owl:ObjectProperty .

# TechnicalDebt → skos:closeMatch → Improvement
# Rationale: technical debt is deferred improvement work —
# semantically close but not identical to Improvement
arto:Improvement
    skos:closeMatch
        <http://www.ub.bw/ontologies/arto#TechnicalDebt> .

# EnhancementRequest → skos:exactMatch → Improvement
# Declared once, in arto-m4-semantic.ttl. The duplicate that stood
# here was removed in v1.1.0 (it made the pair appear twice in the
# CQ8 exactMatch query). Evidence: Query 12, 3,239 individuals,
# 912 sprint-assigned.

# SupportRequest → skos:closeMatch → Bug
# Rationale: support requests often represent user-reported bugs
# not yet formally triaged — close but not exact match
arto:SupportRequest
    skos:closeMatch arto:Bug .

# BuildFailure → skos:closeMatch → Bug
# Rationale: build failures frequently introduce or expose bugs —
# close semantic relationship confirmed by Query 13
# (BuildFailure Duplicate Bug: 43 links)
arto:BuildFailure
    skos:closeMatch arto:Bug .

# Investigation → skos:closeMatch → ProblemTicket
# Rationale: investigations track systemic analysis similar to
# problem tickets — close semantic match
arto:ProblemTicket
    skos:closeMatch
        <http://www.ub.bw/ontologies/arto#Investigation> .

