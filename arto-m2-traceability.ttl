@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix arto: <http://www.ub.bw/ontologies/arto#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .

# ═══════════════════════════════════════════════════════════════════════
# ARTO — M2 Traceability Module
# University of Botswana · PhD Research · Tshepho Koboyatshwene
#
# Imports: arto-m1-step5.ttl (full M1 chain)
#
# This module provides:
#   1. TraceLink class hierarchy with SDLC-aware subclasses
#   2. TraceLinkType controlled vocabulary (7 semantic clusters)
#   3. TraceLink data + object properties
#   4. Rules R1–R4: R1 impact inference and R2 test coverage are
#      executable SWRL rules in this file; R3 is executable in M4;
#      R4 is documentation only (orphan detection needs negation)
#   5. SDLC link direction via ETL (sdlcLinkDirection data property)
#
# TraceLink hierarchy:
#   arto:TraceLink
#   ├── arto:AssertedLink      ← TAWOS Issue_Links (ETL populated)
#   ├── arto:InferredLink      ← HermiT SWRL inferred
#   ├── arto:ForwardSDLCLink   ← Requirements→Design→Implementation→...
#   ├── arto:BackwardSDLCLink  ← Bug→Story, BuildFailure→CodeCommit
#   └── arto:CrossCuttingLink  ← TestCase→UserStory, Version→UserStory
#
# TraceLinkType named individuals (7 semantic clusters):
#   arto:AssociativeLink_Type  ← relatesTo · references · supersedes
#   arto:DependencyLink_Type   ← dependsOn · blocks · hasImplementingTask
#                                 follows · impacts (inferred only)
#   arto:DuplicationLink_Type  ← duplicates
#   arto:StructuralLink_Type   ← hasPart · containedIn · hasStory
#   arto:DefectLink_Type       ← causes · reportedIn · fixes · addresses
#   arto:DeploymentLink_Type   ← fixedIn · affectedIn
#   arto:DesignLink_Type       ← refines · realizes · derives · tracesTo
#                                 verifies · documents
#
# Rules:
#   R1 — Impact inference, R1a–R1e (CQ4). Not itself transitive:
#        chaining comes from impacts being owl:TransitiveProperty.
#   R2 — Test coverage inference, R2a–R2b (CQ3/CQ5)
#   R3 — Semantic equivalence propagation, R3a–R3c (CQ8) — encoded
#        and executable in arto-m4-semantic.ttl
#   R4 — OrphanArtefact classification (CQ5) — documentation only.
#        A Horn rule cannot express negation; CQ5 is answered by the
#        two-way OrphanArtefact definition (M1 Step 2) and SPARQL MINUS.
#
# v1.1.0 changes:
#   - R1a–R1d and R2a–R2b added as executable swrl:Imp rules (end of
#     file). Previously documented in rdfs:comment only and never
#     loaded. They load into Protégé 4.3's Rules view and HermiT
#     applies them during reasoning (DL-safe rules).
#   - SWRLTab/Drools instructions replaced (Protégé 4.3 has no SWRLTab).
#   - R1 relabelled: it infers impacts but is not a transitivity rule.
#   - R3 and R4 documentation brought in line with M4 and M1 Step 2.
#   - Cluster volumes for addresses (44→22) and documents (114→5)
#     corrected to the Oct 2026 outbound-only audit (see M1 Step 5).
#   - Design cluster recomputed from outbound-only counts: 6,012
#     (verifies 5,426 · derives 570 · realizes 11 · documents 5).
#   - All six Issue_Links clusters recomputed from OUTBOUND-only counts
#     mapped through arto_link_type_lookup (65 link names, all mapped):
#     Associative 57,779 · Duplication 29,456 · Dependency 18,957 ·
#     Design 6,012 · Structural 3,261 · Defect 1,596.
#   - hasStory moved from Dependency to Structural (matches M1 Step 2).
#   - v1.2.0: R1e added — Bug(?b) ^ blocks(?b, ?s) ^ UserStory(?s)
#     -> impacts(?b, ?s). reportedIn has no TAWOS source, so R1c fires
#     on the pilot only; R1e gives R1 Bug→Story support on TAWOS
#     (239 Blocks/Blocker links).
#   - follows (25) and impacts (inferred only) added to Dependency;
#     every ARTO trace property now belongs to exactly one cluster.
#     Included 117,061 links (all seven clusters; follows 25 now in
#     Dependency);
#     excluded 6,235 (Cloners 3,780, Gantt types, Risk, etc.);
#     total 123,296. Earlier figures double-counted both directions.
#   - hasImplementingTask: 338 (M1 Step 2 v1.2.0; Associative and
#     Structural Story→Task/Sub-task links; derived by type pair, so
#     not added to the Dependency volume).
#   - reportedIn: no TAWOS source; pilot only (M1 Step 2 v1.2.0).
#   - Deployment audited from the version junction tables (Nov 2026):
#     fixedIn 224,254 + affectedIn 264,004 = 488,258 distinct rows.
#
# P1 — RequirementCandidate promotion (CQ-PROMO) — ETL pattern, NOT
#      SWRL. Reclassifying RequirementCandidate → UserStory in place
#      via SWRL is unimplementable given their owl:disjointWith
#      declaration (Step 1); ETL instead mints a new UserStory linked
#      back via arto:supersedes. See arto:P1_RequirementCandidatePromotion
#      below for full rationale and the CQ-PROMO SPARQL query.
#
# sdlcLinkDirection: set by ETL (not SWRL) for performance —
#   ETL lookup: source/target AgileArtefact subclass → SDLC phase
#   → direction value: Forward · Backward · CrossCutting · Horizontal
#
# CQs covered:
#   CQ3  — test coverage gaps (R2 + SPARQL MINUS)
#   CQ4  — transitive impact propagation (R1)
#   CQ5  — orphan detection (OrphanArtefact class + SPARQL MINUS)
#   CQ6  — inferred vs asserted link ratio (isInferred property)
#   CQ7  — link type distribution (hasLinkType + TraceLinkType)
#   CQ8  — synonym resolution (R3 + skos:exactMatch)
#   CQ-PROMO — RequirementCandidate promotion history (P1 + supersedes)
#
# Add to catalog-v001.xml:
#   <uri name="http://www.ub.bw/ontologies/arto/m2-traceability"
#        uri="arto-m2-traceability.ttl"/>
#
# Load into Protégé 4.3:
#   File → Open → arto-root.ttl (resolves the full chain via catalog)
#   Window → Views → Ontology views → Rules: R1a–R1e, R2a–R2b listed
#     here, R3a–R3c from M4 (10 rules in total)
#   Reasoner → HermiT → Start reasoner
#   Inferred values appear highlighted in the Individuals tab.
#   SPARQL shows asserted triples only, so it cannot confirm rule output.
#   Expected: 5 new classes · 7 named individuals · 7 rules in this file
# ═══════════════════════════════════════════════════════════════════════

<http://www.ub.bw/ontologies/arto/m2-traceability>
    a owl:Ontology ;
    rdfs:label "ARTO M2 Traceability Module"@en ;
    rdfs:comment "ARTO M2 Traceability Module — TraceLink hierarchy, TraceLinkType controlled vocabulary (7 semantic clusters), SDLC link direction, and executable SWRL rules R1 (impact inference) and R2 (test coverage). R3 is executable in M4; R4 is documentation only. Covers CQ3, CQ4, CQ5, CQ6, CQ7, CQ8."@en ;
    owl:imports <http://www.ub.bw/ontologies/arto/m1-step5> ;
    owl:versionInfo "1.2.0 — M2: TraceLink + TraceLinkType + executable SWRL R1a–R1e, R2a–R2b; cluster volumes audited OUTBOUND-only; R1e added (Nov 2026)" .


# ═══════════════════════════════════════════════════════════════════════
# TRACELINK DATA PROPERTIES
# ═══════════════════════════════════════════════════════════════════════

arto:linkId
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "link ID"@en ;
    rdfs:comment "TAWOS: Issue_Links.ID (Int). Primary key of the Issue_Links table. Uniquely identifies an AssertedLink individual."@en ;
    rdfs:domain arto:TraceLink ;
    rdfs:range xsd:integer .

arto:linkName
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "link name"@en ;
    rdfs:comment "TAWOS: Issue_Links.Name (String). The raw TAWOS link type name e.g. Relates, Blocks, Duplicate. Preserved for M4 drift analysis and CQ7 distribution queries."@en ;
    rdfs:domain arto:TraceLink ;
    rdfs:range xsd:string .

arto:linkDirection
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "link direction"@en ;
    rdfs:comment "TAWOS: Issue_Links.Direction (String). The Jira-level direction of this link e.g. inward, outward. Distinct from sdlcLinkDirection which captures SDLC phase direction."@en ;
    rdfs:domain arto:TraceLink ;
    rdfs:range xsd:string .

arto:isInferred
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is inferred"@en ;
    rdfs:comment "Whether this TraceLink was inferred by HermiT SWRL rules (true) or asserted directly from TAWOS Issue_Links (false). Core CQ6 property — enables inferred vs asserted link ratio calculation."@en ;
    rdfs:domain arto:TraceLink ;
    rdfs:range xsd:boolean .

arto:confidenceScore
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "confidence score"@en ;
    rdfs:comment "Confidence of this TraceLink. Range: 0.0–1.0. AssertedLinks: 1.0 (ground truth). InferredLinks: set by SWRL rule confidence. Literature-grounded: supports future probabilistic RT extensions."@en ;
    rdfs:domain arto:TraceLink ;
    rdfs:range xsd:decimal .

arto:assertionMethod
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assertion method"@en ;
    rdfs:comment "How this TraceLink was created. Values: ETL (from TAWOS Issue_Links), SWRL (HermiT inferred), Manual (human-asserted). Core CQ6 property."@en ;
    rdfs:domain arto:TraceLink ;
    rdfs:range xsd:string .

arto:linkCreatedAt
    a owl:DatatypeProperty ;
    rdfs:label "link created at"@en ;
    rdfs:comment "TAWOS: derived from Issue_Links creation context. When this trace link was established. Supports temporal RT chain analysis."@en ;
    rdfs:domain arto:TraceLink ;
    rdfs:range xsd:dateTime .

arto:sdlcLinkDirection
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "SDLC link direction"@en ;
    rdfs:comment "Direction of this TraceLink relative to the SDLC lifecycle. Set by ETL using source/target artefact class membership lookup. Values: Forward (Requirements→Implementation), Backward (Maintenance→Requirements), CrossCutting (Testing→Requirements), Horizontal (same SDLC phase). Enables CQ-SDLC1 full lifecycle chain queries."@en ;
    rdfs:domain arto:TraceLink ;
    rdfs:range xsd:string .

arto:sourcePhase
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source phase"@en ;
    rdfs:comment "SDLC phase of the source artefact. Set by ETL. Values: Requirements · Design · Implementation · Testing · Deployment · Maintenance. Used with targetPhase to determine sdlcLinkDirection."@en ;
    rdfs:domain arto:TraceLink ;
    rdfs:range xsd:string .

arto:targetPhase
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "target phase"@en ;
    rdfs:comment "SDLC phase of the target artefact. Set by ETL. Values: Requirements · Design · Implementation · Testing · Deployment · Maintenance."@en ;
    rdfs:domain arto:TraceLink ;
    rdfs:range xsd:string .


# ═══════════════════════════════════════════════════════════════════════
# TRACELINK OBJECT PROPERTIES
# ═══════════════════════════════════════════════════════════════════════

arto:hasSourceArtefact
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has source artefact"@en ;
    rdfs:comment "The AgileArtefact from which this TraceLink originates. Functional — each TraceLink has exactly one source."@en ;
    rdfs:domain arto:TraceLink ;
    rdfs:range arto:AgileArtefact .

arto:hasTargetArtefact
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has target artefact"@en ;
    rdfs:comment "The AgileArtefact to which this TraceLink points. Functional — each TraceLink has exactly one target."@en ;
    rdfs:domain arto:TraceLink ;
    rdfs:range arto:AgileArtefact .

arto:hasLinkType
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has link type"@en ;
    rdfs:comment "The semantic cluster this TraceLink belongs to. Points to one of the 7 TraceLinkType named individuals. Functional — each link belongs to exactly one semantic cluster. Core CQ7 property."@en ;
    rdfs:domain arto:TraceLink ;
    rdfs:range arto:TraceLinkType .

arto:isRelatedTraceLink
    a owl:ObjectProperty ;
    rdfs:label "is related trace link"@en ;
    rdfs:comment "Links related TraceLink individuals e.g. an InferredLink to the AssertedLinks that triggered its inference. Supports CQ6 provenance queries."@en ;
    rdfs:domain arto:TraceLink ;
    rdfs:range arto:TraceLink .


# ═══════════════════════════════════════════════════════════════════════
# CLASS: arto:TraceLink
# Root class for all trace link individuals.
# Bridges M1 artefact individuals to their RT connections.
# ═══════════════════════════════════════════════════════════════════════

arto:TraceLink
    a owl:Class ;
    rdfs:label "Trace Link"@en ;
    rdfs:comment "A directed traceability link between two AgileArtefact individuals. Root class for AssertedLink, InferredLink, ForwardSDLCLink, BackwardSDLCLink, and CrossCuttingLink. Each TraceLink individual carries source/target artefacts, link type (semantic cluster), SDLC direction, and assertion method. Bridges M1 artefact hierarchy to M2 traceability analysis."@en ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:hasSourceArtefact ;
          owl:cardinality 1 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:hasTargetArtefact ;
          owl:cardinality 1 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:hasLinkType ;
          owl:cardinality 1 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:isInferred ;
          owl:cardinality 1 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:assertionMethod ;
          owl:cardinality 1 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:confidenceScore ;
          owl:cardinality 1 ] ;

    owl:hasKey ( arto:linkId ) .


# ═══════════════════════════════════════════════════════════════════════
# TRACELINK SUBCLASSES
# Note: subclasses are NOT mutually exclusive — a single TraceLink
# individual can be both AssertedLink AND ForwardSDLCLink.
# OWL allows multiple class membership (open world assumption).
# ═══════════════════════════════════════════════════════════════════════

arto:AssertedLink
    a owl:Class ;
    rdfs:label "Asserted Link"@en ;
    rdfs:comment "A TraceLink directly populated from TAWOS Issue_Links table by the Python ETL pipeline. isInferred = false · assertionMethod = ETL · confidenceScore = 1.0. Corresponds to ground-truth RT links in the TAWOS dataset."@en ;
    rdfs:subClassOf arto:TraceLink ;
    owl:disjointWith arto:InferredLink .

arto:InferredLink
    a owl:Class ;
    rdfs:label "Inferred Link"@en ;
    rdfs:comment "A TraceLink discovered by HermiT via SWRL rules — not present in TAWOS Issue_Links. isInferred = true · assertionMethod = SWRL · confidenceScore set per rule. Represents latent traceability recovered by ARTO's reasoning layer. Core CQ6 contribution — quantifies ARTO's inferential power over raw TAWOS data."@en ;
    rdfs:subClassOf arto:TraceLink ;
    owl:disjointWith arto:AssertedLink .

arto:ForwardSDLCLink
    a owl:Class ;
    rdfs:label "Forward SDLC Link"@en ;
    rdfs:comment "A TraceLink where the source artefact belongs to an earlier SDLC phase than the target. sdlcLinkDirection = Forward. Examples: UserStory hasImplementingTask SprintTask (Requirements→Implementation), SprintTask tracesTo CodeCommit (Implementation→Implementation), TestCase verifies UserStory (Testing→Requirements is CrossCutting not Forward). Set by ETL."@en ;
    rdfs:subClassOf arto:TraceLink .

arto:BackwardSDLCLink
    a owl:Class ;
    rdfs:label "Backward SDLC Link"@en ;
    rdfs:comment "A TraceLink where the source artefact belongs to a later SDLC phase than the target — defect traceability upstream. sdlcLinkDirection = Backward. Examples: Bug reportedIn UserStory (Maintenance→Requirements), BuildFailure relatesTo CodeCommit (Maintenance→Implementation). Critical for CQ4 impact propagation analysis. Set by ETL."@en ;
    rdfs:subClassOf arto:TraceLink .

arto:CrossCuttingLink
    a owl:Class ;
    rdfs:label "Cross Cutting Link"@en ;
    rdfs:comment "A TraceLink that spans non-adjacent SDLC phases skipping intermediate phases. sdlcLinkDirection = CrossCutting. Examples: TestCase verifies UserStory (Testing→Requirements skipping Design and Implementation), Version containedIn UserStory (Deployment→Requirements). Represents high-level governance links in the RT chain. Set by ETL."@en ;
    rdfs:subClassOf arto:TraceLink .


# ═══════════════════════════════════════════════════════════════════════
# CLASS: arto:TraceLinkType
# Controlled vocabulary for RT link semantic clusters.
# 7 named individuals — one per semantic cluster.
# Each TraceLink individual points to exactly one TraceLinkType
# via arto:hasLinkType (Functional property).
# ═══════════════════════════════════════════════════════════════════════

arto:TraceLinkType
    a owl:Class ;
    rdfs:label "Trace Link Type"@en ;
    rdfs:comment "Controlled vocabulary class for RT link semantic clusters. 7 named individuals cover all 24 ARTO RT properties grouped by semantic meaning. Each TraceLink individual points to exactly one TraceLinkType via arto:hasLinkType. Enables CQ7 link type distribution queries without enumerating all 24 individual property names."@en .

arto:TraceLinkType_label
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "type label"@en ;
    rdfs:comment "Human-readable label for this TraceLinkType cluster."@en ;
    rdfs:domain arto:TraceLinkType ;
    rdfs:range xsd:string .

arto:TraceLinkType_properties
    a owl:DatatypeProperty ;
    rdfs:label "covered properties"@en ;
    rdfs:comment "Comma-separated list of arto: RT properties covered by this TraceLinkType cluster."@en ;
    rdfs:domain arto:TraceLinkType ;
    rdfs:range xsd:string .

arto:TraceLinkType_tawosVolume
    a owl:DatatypeProperty ;
    rdfs:label "TAWOS volume"@en ;
    rdfs:comment "Total number of TAWOS Issue_Links rows mapped to this TraceLinkType cluster. Grounded in Query 4 results."@en ;
    rdfs:domain arto:TraceLinkType ;
    rdfs:range xsd:integer .


# ═══════════════════════════════════════════════════════════════════════
# TRACELINKTYPE NAMED INDIVIDUALS
# 7 semantic clusters covering all 24 ARTO RT properties
# ═══════════════════════════════════════════════════════════════════════

arto:AssociativeLink_Type
    a arto:TraceLinkType ;
    arto:TraceLinkType_label "Associative"^^xsd:string ;
    arto:TraceLinkType_properties "relatesTo · references · supersedes"^^xsd:string ;
    arto:TraceLinkType_tawosVolume 57779 ;
    rdfs:comment "General associative RT links with no specific directional or structural meaning. All Issue_Links counts OUTBOUND-only (Oct 2026 audit; each link is stored once INBOUND and once OUTBOUND), mapped through arto_link_type_lookup. relatesTo 37,265 (Relates 22,739 + Related 12,754 + Detail 1,048 + Problem/Incident 380 + Relate 344) + references 19,914 (Reference) + supersedes 600 (Supersession 381 + Supercedes 180 + Supersede 39) = 57,779. Largest cluster by volume — backbone of the TAWOS RT network. Supersedes the earlier figure of 112,874, which double-counted both link directions."@en .

arto:DependencyLink_Type
    a arto:TraceLinkType ;
    arto:TraceLinkType_label "Dependency"^^xsd:string ;
    arto:TraceLinkType_properties "dependsOn · blocks · hasImplementingTask · follows · impacts"^^xsd:string ;
    arto:TraceLinkType_tawosVolume 18957 ;
    rdfs:comment "Prerequisite and ordering dependencies between artefacts. All Issue_Links counts OUTBOUND-only (Oct 2026 audit; each link is stored once INBOUND and once OUTBOUND), mapped through arto_link_type_lookup. dependsOn 9,763 (Depends 5,103 + Dependency 4,173 + dependent 266 + Depend 169 + Required 52) + blocks 9,169 (Blocks 4,211 + Blockers 3,124 + Blocker 1,428 + Block 396 + Blocked 10) + follows 25 (Follows) = 18,957 Issue_Links. follows (ordering without a hard dependency) was added in v1.1.0; it was previously in no cluster. impacts is also a member: it is inferred by SWRL R1 and the transitivity of impacts, never loaded from TAWOS, so it adds nothing to the volume (pilot link_005 already types an impacts link as DependencyLink_Type). hasStory (173) was moved to the Structural cluster in v1.1.0: an Epic containing UserStories is a part-whole relationship, as M1 Step 2 already records. hasImplementingTask (338 links: Story→Task/Sub-task links in the Associative and Structural clusters, OUTBOUND-only, Nov 2026, M1 Step 2) is asserted by issue type pair on top of the raw-name property, so those links are already counted above and are not added again here. Supersedes the earlier figure of 38,773, which double-counted both link directions and included hasStory."@en .

arto:DuplicationLink_Type
    a arto:TraceLinkType ;
    arto:TraceLinkType_label "Duplication"^^xsd:string ;
    arto:TraceLinkType_properties "duplicates"^^xsd:string ;
    arto:TraceLinkType_tawosVolume 29456 ;
    rdfs:comment "Duplicate artefact detection links. All Issue_Links counts OUTBOUND-only (Oct 2026 audit; each link is stored once INBOUND and once OUTBOUND), mapped through arto_link_type_lookup. duplicates 29,456 (Duplicate). Cloners (3,780) is deliberately excluded: clone provenance is administrative, not a traceability relationship. Second largest cluster by volume. Critical for M4 synonym resolution. Supersedes the earlier figure of 66,470, which double-counted both directions and included Cloners."@en .

arto:StructuralLink_Type
    a arto:TraceLinkType ;
    arto:TraceLinkType_label "Structural"^^xsd:string ;
    arto:TraceLinkType_properties "hasPart · containedIn · hasStory"^^xsd:string ;
    arto:TraceLinkType_tawosVolume 3261 ;
    rdfs:comment "Compositional and containment links. All Issue_Links counts OUTBOUND-only (Oct 2026 audit; each link is stored once INBOUND and once OUTBOUND), mapped through arto_link_type_lookup. hasPart 3,088 (Part 2,116 + Child-Issue 353 + Includes 230 + Containment 186 + Children 80 + Incorporates 74 + Container 47 + Parent Feature 2) + hasStory 173 (Epic Story) = 3,261. hasStory moved here from Dependency in v1.1.0: an Epic containing UserStories is a part-whole relationship, consistent with M1 Step 2. containedIn has no Issue_Links source (the lookup maps Containment to hasPart). Implements the PartOf Content ODP from M1 Step 2. Supersedes the earlier figure of 6,227."@en .

arto:DefectLink_Type
    a arto:TraceLinkType ;
    arto:TraceLinkType_label "Defect"^^xsd:string ;
    arto:TraceLinkType_properties "causes · reportedIn · fixes · addresses"^^xsd:string ;
    arto:TraceLinkType_tawosVolume 1596 ;
    rdfs:comment "Defect traceability links connecting bugs to their origin and resolution artefacts. All Issue_Links counts OUTBOUND-only (Oct 2026 audit; each link is stored once INBOUND and once OUTBOUND), mapped through arto_link_type_lookup. causes 1,444 (Cause 1,250 + Caused 194) + fixes 130 (Fixes 98 + Resolve 32) + addresses 22 (Addresses) = 1,596 Issue_Links. Regression is no longer counted here: it was reassigned to verifies (M1 Step 3). reportedIn has no TAWOS source: TAWOS records no explicit reported-in link, and its Bug→Story links are mostly Relates, Blocks and Duplicate (M1 Step 2). It is used in the pilot only. The earlier figure of 2,425 counted every Bug–Story link in both directions. Critical for BackwardSDLCLink classification. Supersedes the earlier figure of 10,452."@en .

arto:DeploymentLink_Type
    a arto:TraceLinkType ;
    arto:TraceLinkType_label "Deployment"^^xsd:string ;
    arto:TraceLinkType_properties "fixedIn · affectedIn"^^xsd:string ;
    arto:TraceLinkType_tawosVolume 488258 ;
    rdfs:comment "Deployment lifecycle links connecting artefacts to Version records. Sourced from the TAWOS fix_version and affected_version junction tables, not Issue_Links (Nov 2026 audit). fixedIn 224,254 rows (fix_version; largest: Bug 129,501 · Task 20,807 · Improvement 24,981 · Suggestion 16,722 · Sub-task 10,493 · Story 8,587 · New Feature 8,036) + affectedIn 264,004 rows (affected_version; largest: Bug 202,384 · Improvement 29,620 · New Feature 8,008 · Task 7,979 · Sub-task 7,394 · Story 2,289) = 488,258. Every row is a distinct (issue, version) pair and joins to an issue; junction tables have no direction, so there is no INBOUND/OUTBOUND double counting. Rows on issue types that ARTO does not load as classes (e.g. Question, Wish, Investigation, Technical Debt, Incident) are dropped by the ETL. Largest cluster by volume. Supersedes the earlier figure of 235,324, whose components (141,347 + 160,602) matched neither table."@en .

arto:DesignLink_Type
    a arto:TraceLinkType ;
    arto:TraceLinkType_label "Design"^^xsd:string ;
    arto:TraceLinkType_properties "refines · realizes · derives · tracesTo · verifies · documents"^^xsd:string ;
    arto:TraceLinkType_tawosVolume 6012 ;
    rdfs:comment "Design and verification lifecycle links. TAWOS, all counts OUTBOUND-only (Oct 2026 audit; each link is stored once INBOUND and once OUTBOUND): verifies/Tested+QA Test+Bonfire Testing+Regression (5,426) + derives/Derived+Issue split+Split (570) + realizes/Implements (11) + documents/Documented (5) + tracesTo (literature) + refines (literature) = 6,012 TAWOS-grounded links plus literature-grounded properties for multi-dataset comparability. Supersedes earlier figures (7,416; then 7,191 and 7,172) that mixed double-counted and audited component counts."@en .


# ═══════════════════════════════════════════════════════════════════════
# IMPACTS PROPERTY
# Key SWRL-inferred transitive property for CQ4.
# Not in TAWOS Issue_Links directly — inferred by R1.
# SubPropertyOf hasTraceLink so inferred impacts appear in
# CQ5 coverage queries automatically.
# ═══════════════════════════════════════════════════════════════════════

arto:impacts
    a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "impacts"@en ;
    rdfs:comment "Transitive impact property inferred by SWRL Rule R1. If a UserStory has an implementing SprintTask that traces to a CodeCommit, then the UserStory impacts the CodeCommit. Transitive: if A impacts B and B impacts C then A impacts C. SubPropertyOf hasTraceLink — all inferred impact links count in CQ5 coverage queries. Not directly asserted in ETL — produced by HermiT SWRL reasoning."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range arto:AgileArtefact ;
    rdfs:subPropertyOf arto:hasTraceLink .

arto:isImpactedBy
    a owl:ObjectProperty ;
    rdfs:label "is impacted by"@en ;
    rdfs:comment "Inverse of arto:impacts. Inferred by HermiT."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range arto:AgileArtefact ;
    owl:inverseOf arto:impacts .


# ═══════════════════════════════════════════════════════════════════════
# SWRL RULES
# R1–R4 covering CQ3 · CQ4 · CQ5 · CQ8
#
# The named individuals below keep the human-readable documentation.
# The executable rules are encoded as swrl:Imp at the end of this
# file (R1a–R1e, R2a–R2b) and in arto-m4-semantic.ttl (R3a–R3c).
# They load automatically into Protégé 4.3's Rules view
# (Window → Views → Ontology views → Rules). The rules are DL-safe,
# so HermiT applies them during reasoning; no separate rule engine
# is used.
# ═══════════════════════════════════════════════════════════════════════

# ── R1: Impact Inference (CQ4) ────────────────────────────────────────
# R1 is not itself a transitivity rule. It derives impacts links from
# implementation, tracing and defect chains; chaining beyond one step
# comes from the owl:TransitiveProperty declaration on impacts.
# Fires when: UserStory has an implementing task that traces to a commit
# Infers: the UserStory impacts the CodeCommit
# CQ4 query: "what artefacts are impacted if UserStory ?s changes?"
# Chain: UserStory → SprintTask → CodeCommit → impacts inferred
# Extended chain: impacts is Transitive so:
#   UserStory impacts CodeCommit AND CodeCommit impacts TestCase
#   → UserStory transitively impacts TestCase

arto:R1_TransitiveImpact
    a owl:NamedIndividual ;
    rdfs:label "R1 — Impact Inference"@en ;
    rdfs:comment """SWRL Rule R1 — Impact Inference (CQ4)
Executable as R1a–R1e (swrl:Imp at the end of this file).

Rules view syntax:
UserStory(?s) ^ hasImplementingTask(?s, ?t) ^ SprintTask(?t) -> impacts(?s, ?t)
UserStory(?s) ^ hasImplementingTask(?s, ?t) ^ tracesTo(?t, ?c) ^ CodeCommit(?c) -> impacts(?s, ?c)
Bug(?b) ^ reportedIn(?b, ?s) ^ UserStory(?s) -> impacts(?b, ?s)
Bug(?b) ^ causes(?b, ?b2) ^ Bug(?b2) -> impacts(?b, ?b2)
Bug(?b) ^ blocks(?b, ?s) ^ UserStory(?s) -> impacts(?b, ?s)   [R1e, added Nov 2026]

Explanation:
- Rule fires on all UserStory individuals with hasImplementingTask assertions
- Infers impacts from UserStory to SprintTask and transitively to CodeCommit
- Bug causation chains are also captured via causes property
- impacts is declared Transitive so HermiT extends chains automatically
- All inferred impacts count as hasTraceLink via SubPropertyOf declaration
- An ETL post-processing step is designed to record inferred links
  as InferredLink individuals (link_005 in the pilot shows the form;
  it is asserted pilot data, not reasoner output)
- SPARQL in Protégé 4.3 reads asserted triples only, so the query
  below returns asserted impacts; inferred ones show in the
  Individuals tab after HermiT runs

CQ4 SPARQL:
SELECT ?s ?impacted WHERE {
  ?s a arto:UserStory .
  ?s arto:impacts ?impacted .
}"""@en .

# ── R2: Test Coverage Inference (CQ3/CQ5) ────────────────────────────
# Fires when: TestCase verifies a UserStory
# Infers: the UserStory has a hasTraceLink to the TestCase
# CQ3: stories with no incoming verifies link = test coverage gap
# CQ5: gaps detected via OrphanArtefact or SPARQL MINUS

arto:R2_TestCoverageInference
    a owl:NamedIndividual ;
    rdfs:label "R2 — Test Coverage Inference"@en ;
    rdfs:comment """SWRL Rule R2 — Test Coverage Inference (CQ3/CQ5)
Executable as R2a–R2b (swrl:Imp at the end of this file).

Rules view syntax:
TestCase(?tc) ^ verifies(?tc, ?s) ^ UserStory(?s) -> hasTraceLink(?s, ?tc)
TestCase(?tc) ^ verifies(?tc, ?b) ^ Bug(?b) -> hasTraceLink(?b, ?tc)

Explanation:
- Ensures test-story links appear in hasTraceLink coverage queries
- Without this rule, verifies assertions exist but story_001 may not
  appear in hasTraceLink-based orphan detection
- The inverse direction (story hasTraceLink testcase) is needed for
  CQ5 to correctly exclude verified stories from OrphanArtefact
- Creates InferredLink with:
    assertionMethod = SWRL
    hasLinkType = arto:DesignLink_Type
    isInferred = true
    sdlcLinkDirection = CrossCutting

CQ3a SPARQL:
SELECT ?tc ?story WHERE {
  ?tc a arto:TestCase .
  ?tc arto:verifies ?story .
  ?story a arto:UserStory .
}

CQ3b SPARQL (stories with no test coverage):
SELECT ?story WHERE {
  ?story a arto:UserStory .
  MINUS { ?tc arto:verifies ?story . }
}"""@en .

# ── R3: Semantic Equivalence Propagation (CQ8) ───────────────────────
# Fires when: two AgileArtefact individuals are skos:exactMatch
# Infers: trace links and impacts links from one propagate to the other
# Encoded and executable in arto-m4-semantic.ttl (R3a–R3c); this
# individual is documentation only. Fires after M4 is loaded.

arto:R3_SemanticEquivalencePropagation
    a owl:NamedIndividual ;
    rdfs:label "R3 — Semantic Equivalence Propagation"@en ;
    rdfs:comment """SWRL Rule R3 — Semantic Equivalence Propagation (CQ8)
Executable as R3a–R3c in arto-m4-semantic.ttl. Documentation only here.

R3a: AgileArtefact(?v1) ^ AgileArtefact(?v2) ^
     skos:exactMatch(?v1, ?v2) ^ hasTraceLink(?v1, ?l) -> hasTraceLink(?v2, ?l)
R3b: AgileArtefact(?v1) ^ AgileArtefact(?v2) ^
     skos:exactMatch(?v1, ?v2) ^ hasTraceLink(?v2, ?l) -> hasTraceLink(?v1, ?l)
R3c: AgileArtefact(?v1) ^ AgileArtefact(?v2) ^
     skos:exactMatch(?v1, ?v2) ^ impacts(?v1, ?t) -> impacts(?v2, ?t)

Explanation:
- Fires when two artefacts are declared skos:exactMatch (synonyms)
- R3b is required: SKOS is not imported and exactMatch is not declared
  symmetric, so the reasoner does not infer the reverse of a pair
- skos:exactMatch must be an object property (declared in M1 Step 5,
  M4 and the pilot) or SWRL cannot use it
- Verified on the pilot: story_equiv and bug_equiv receive the trace
  and impacts links of story_001 and bug_001 with HermiT active

CQ8 SPARQL:
SELECT ?v1 ?v2 ?link WHERE {
  ?v1 skos:exactMatch ?v2 .
  ?v1 arto:hasTraceLink ?link .
  ?v2 arto:hasTraceLink ?link .
}"""@en .

# ── R4: OrphanArtefact Classification (CQ5) ──────────────────────────
# Documentation only — not loaded as a rule. Orphan detection needs
# negation, which a Horn rule cannot express. OrphanArtefact is
# defined in M1 Step 2 by owl:equivalentClass with no outgoing and no
# incoming hasTraceLink. Under the open world assumption HermiT never
# places a populated individual in it, so CQ5 is answered by SPARQL
# MINUS (closed world).

arto:R4_OrphanArtefactClassification
    a owl:NamedIndividual ;
    rdfs:label "R4 — OrphanArtefact Classification"@en ;
    rdfs:comment """R4 — OrphanArtefact Classification (CQ5) — documentation only

R4 is not loaded as a rule. Orphan detection needs negation
(no hasTraceLink), which a Horn rule cannot express. An earlier
placeholder, AgileArtefact(?a) ^ hasTraceLink(?a, ?l) -> hasTraceLink(?a, ?l),
restated its own premise and inferred nothing; it has been removed.

OrphanArtefact is defined in M1 Step 2 (two-way):
  OrphanArtefact ≡ AgileArtefact ⊓ ¬∃hasTraceLink.⊤ ⊓ ¬∃hasTraceLink⁻.⊤
Under the open world assumption HermiT never classifies a populated
individual into it.

CQ5 is answered by SPARQL MINUS (closed world), checking both
directions:
SELECT ?artefact WHERE {
  ?artefact a ?type .
  ?type rdfs:subClassOf* arto:AgileArtefact .
  MINUS { ?artefact arto:hasTraceLink ?out . }
  MINUS { ?in arto:hasTraceLink ?artefact . }
}
Note: the embedded engine reads asserted triples only, so links that
exist only through inference (sub-property, R2, R3) do not exclude
an artefact from this result."""@en .


# ── P1: RequirementCandidate Promotion (ETL, not SWRL) ─────────────────
# Fires when: isAccepted flips to true on a RequirementCandidate
# Not a SWRL rule — deliberately implemented at the ETL layer instead.
# See rdfs:comment on arto:isAccepted (M1 Step 1) and arto:supersedes
# (M1 Step 3) for the full rationale.

arto:P1_RequirementCandidatePromotion
    a owl:NamedIndividual ;
    rdfs:label "P1 — RequirementCandidate Promotion (ETL pattern, not SWRL)"@en ;
    rdfs:comment """P1 — RequirementCandidate Promotion (CQ-PROMO)

WHY THIS IS NOT A SWRL RULE:
The original methodology (M1 Step 1, through v3) planned this as a
SWRL rule: RequirementCandidate(?rc) ^ isAccepted(?rc, true) -> UserStory(?rc).
This is unimplementable as written: RequirementCandidate and UserStory
are declared owl:disjointWith each other, so a reasoner firing this
rule would find the individual satisfying two disjoint classes and
report the whole ontology inconsistent — not merely that individual
unsatisfiable. SWRL's monotonicity compounds the problem: even if
disjointness were relaxed, the rule could only add the UserStory type,
never retract the original RequirementCandidate subtype, so the
individual would carry both types permanently rather than being
genuinely reclassified.

ADOPTED PATTERN (ETL, non-monotonic by design):
WHERE ?rc isAccepted true, ETL:
  1. Mints a new UserStory individual (new issueId/issueKey)
  2. Asserts: newStory arto:supersedes ?rc
  3. Leaves ?rc's rdf:type and all pre-acceptance trace links untouched

This gives clean, non-monotonic reclassification semantics (the
promoted requirement genuinely 'becomes' a UserStory going forward)
while keeping RequirementCandidate/UserStory disjointness — and every
structural metric in Chapter 8 that depends on it — fully intact.

CQ-PROMO SPARQL (promotion history):
SELECT ?candidate ?candidateType ?promoted WHERE {
  ?promoted a arto:UserStory .
  ?promoted arto:supersedes ?candidate .
  ?candidate a ?candidateType .
  ?candidateType rdfs:subClassOf* arto:RequirementCandidate .
}

Pilot verification: story_004 arto:supersedes suggestion_002 ;
suggestion_002 a arto:Suggestion ; suggestion_002 arto:isAccepted true."""@en .


# ═══════════════════════════════════════════════════════════════════════
# SDLC PHASE LOOKUP TABLE
# Declared as annotation properties for ETL documentation.
# ETL uses this mapping to set sourcePhase and targetPhase
# on TraceLink individuals, then derives sdlcLinkDirection.
# ═══════════════════════════════════════════════════════════════════════

arto:SDLCPhaseLookup
    a owl:NamedIndividual ;
    rdfs:label "SDLC Phase Lookup Table"@en ;
    rdfs:comment """ETL lookup table for sdlcLinkDirection calculation:

ARTEFACT CLASS → SDLC PHASE:
  Epic, UserStory, RequirementCandidate,
  Suggestion, Improvement, NewFeature     → Requirements
  ArchitectureDocument, DesignModel,
  Prototype                               → Design
  SprintTask, CodeCommit                  → Implementation
  TestCase, TestResult                    → Testing
  Version, PlannedRelease                 → Deployment
  Bug, Documentation, SupportRequest,
  BuildFailure, ProblemTicket             → Maintenance

SDLC DIRECTION RULES:
  sourcePhase == targetPhase              → Horizontal
  sourcePhase precedes targetPhase        → Forward
  sourcePhase follows targetPhase         → Backward
  phases are non-adjacent (skip ≥1)      → CrossCutting

PHASE ORDER: Requirements < Design < Implementation
             < Testing < Deployment < Maintenance

EXAMPLES:
  UserStory → SprintTask:  Requirements→Implementation = Forward
  Bug → UserStory:         Maintenance→Requirements    = Backward
  TestCase → UserStory:    Testing→Requirements        = CrossCutting
  Bug → Bug:               Maintenance→Maintenance     = Horizontal"""@en .


# ═══════════════════════════════════════════════════════════════════════
# EXECUTABLE SWRL RULES — R1a–R1e, R2a–R2b (swrl:Imp)
# Load into Protégé 4.3's Rules view; HermiT applies them during
# reasoning. Variables use Protégé's convention urn:swrl:var#.
# R3a–R3c are encoded the same way in arto-m4-semantic.ttl.
# ═══════════════════════════════════════════════════════════════════════

<urn:swrl:var#s> a swrl:Variable .
<urn:swrl:var#t> a swrl:Variable .
<urn:swrl:var#c> a swrl:Variable .
<urn:swrl:var#b> a swrl:Variable .
<urn:swrl:var#b2> a swrl:Variable .
<urn:swrl:var#tc> a swrl:Variable .

# R1a
[ a swrl:Imp ;
  rdfs:label "R1a"@en ;
  rdfs:comment "UserStory(?s) ^ hasImplementingTask(?s, ?t) ^ SprintTask(?t) -> impacts(?s, ?t)"@en ;
  swrl:body [ a swrl:AtomList ;
      rdf:first [ a swrl:ClassAtom ; swrl:classPredicate arto:UserStory ; swrl:argument1 <urn:swrl:var#s> ] ;
      rdf:rest [ a swrl:AtomList ;
        rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate arto:hasImplementingTask ; swrl:argument1 <urn:swrl:var#s> ; swrl:argument2 <urn:swrl:var#t> ] ;
        rdf:rest [ a swrl:AtomList ;
          rdf:first [ a swrl:ClassAtom ; swrl:classPredicate arto:SprintTask ; swrl:argument1 <urn:swrl:var#t> ] ;
          rdf:rest rdf:nil ] ] ] ;
  swrl:head [ a swrl:AtomList ;
      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate arto:impacts ; swrl:argument1 <urn:swrl:var#s> ; swrl:argument2 <urn:swrl:var#t> ] ;
      rdf:rest rdf:nil ]
] .

# R1b
[ a swrl:Imp ;
  rdfs:label "R1b"@en ;
  rdfs:comment "UserStory(?s) ^ hasImplementingTask(?s, ?t) ^ tracesTo(?t, ?c) ^ CodeCommit(?c) -> impacts(?s, ?c)"@en ;
  swrl:body [ a swrl:AtomList ;
      rdf:first [ a swrl:ClassAtom ; swrl:classPredicate arto:UserStory ; swrl:argument1 <urn:swrl:var#s> ] ;
      rdf:rest [ a swrl:AtomList ;
        rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate arto:hasImplementingTask ; swrl:argument1 <urn:swrl:var#s> ; swrl:argument2 <urn:swrl:var#t> ] ;
        rdf:rest [ a swrl:AtomList ;
          rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate arto:tracesTo ; swrl:argument1 <urn:swrl:var#t> ; swrl:argument2 <urn:swrl:var#c> ] ;
          rdf:rest [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ; swrl:classPredicate arto:CodeCommit ; swrl:argument1 <urn:swrl:var#c> ] ;
            rdf:rest rdf:nil ] ] ] ] ;
  swrl:head [ a swrl:AtomList ;
      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate arto:impacts ; swrl:argument1 <urn:swrl:var#s> ; swrl:argument2 <urn:swrl:var#c> ] ;
      rdf:rest rdf:nil ]
] .

# R1c
[ a swrl:Imp ;
  rdfs:label "R1c"@en ;
  rdfs:comment "Bug(?b) ^ reportedIn(?b, ?s) ^ UserStory(?s) -> impacts(?b, ?s)"@en ;
  swrl:body [ a swrl:AtomList ;
      rdf:first [ a swrl:ClassAtom ; swrl:classPredicate arto:Bug ; swrl:argument1 <urn:swrl:var#b> ] ;
      rdf:rest [ a swrl:AtomList ;
        rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate arto:reportedIn ; swrl:argument1 <urn:swrl:var#b> ; swrl:argument2 <urn:swrl:var#s> ] ;
        rdf:rest [ a swrl:AtomList ;
          rdf:first [ a swrl:ClassAtom ; swrl:classPredicate arto:UserStory ; swrl:argument1 <urn:swrl:var#s> ] ;
          rdf:rest rdf:nil ] ] ] ;
  swrl:head [ a swrl:AtomList ;
      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate arto:impacts ; swrl:argument1 <urn:swrl:var#b> ; swrl:argument2 <urn:swrl:var#s> ] ;
      rdf:rest rdf:nil ]
] .

# R1d
[ a swrl:Imp ;
  rdfs:label "R1d"@en ;
  rdfs:comment "Bug(?b) ^ causes(?b, ?b2) ^ Bug(?b2) -> impacts(?b, ?b2)"@en ;
  swrl:body [ a swrl:AtomList ;
      rdf:first [ a swrl:ClassAtom ; swrl:classPredicate arto:Bug ; swrl:argument1 <urn:swrl:var#b> ] ;
      rdf:rest [ a swrl:AtomList ;
        rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate arto:causes ; swrl:argument1 <urn:swrl:var#b> ; swrl:argument2 <urn:swrl:var#b2> ] ;
        rdf:rest [ a swrl:AtomList ;
          rdf:first [ a swrl:ClassAtom ; swrl:classPredicate arto:Bug ; swrl:argument1 <urn:swrl:var#b2> ] ;
          rdf:rest rdf:nil ] ] ] ;
  swrl:head [ a swrl:AtomList ;
      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate arto:impacts ; swrl:argument1 <urn:swrl:var#b> ; swrl:argument2 <urn:swrl:var#b2> ] ;
      rdf:rest rdf:nil ]
] .

# R1e — a bug that blocks a story impacts it (added v1.2.0, Nov 2026;
# TAWOS: 239 Bug→Story Blocks/Blocker links, OUTBOUND-only)
[ a swrl:Imp ;
  rdfs:label "R1e"@en ;
  rdfs:comment "Bug(?b) ^ blocks(?b, ?s) ^ UserStory(?s) -> impacts(?b, ?s)"@en ;
  swrl:body [ a swrl:AtomList ;
      rdf:first [ a swrl:ClassAtom ; swrl:classPredicate arto:Bug ; swrl:argument1 <urn:swrl:var#b> ] ;
      rdf:rest [ a swrl:AtomList ;
        rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate arto:blocks ; swrl:argument1 <urn:swrl:var#b> ; swrl:argument2 <urn:swrl:var#s> ] ;
        rdf:rest [ a swrl:AtomList ;
          rdf:first [ a swrl:ClassAtom ; swrl:classPredicate arto:UserStory ; swrl:argument1 <urn:swrl:var#s> ] ;
          rdf:rest rdf:nil ] ] ] ;
  swrl:head [ a swrl:AtomList ;
      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate arto:impacts ; swrl:argument1 <urn:swrl:var#b> ; swrl:argument2 <urn:swrl:var#s> ] ;
      rdf:rest rdf:nil ]
] .

# R2a
[ a swrl:Imp ;
  rdfs:label "R2a"@en ;
  rdfs:comment "TestCase(?tc) ^ verifies(?tc, ?s) ^ UserStory(?s) -> hasTraceLink(?s, ?tc)"@en ;
  swrl:body [ a swrl:AtomList ;
      rdf:first [ a swrl:ClassAtom ; swrl:classPredicate arto:TestCase ; swrl:argument1 <urn:swrl:var#tc> ] ;
      rdf:rest [ a swrl:AtomList ;
        rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate arto:verifies ; swrl:argument1 <urn:swrl:var#tc> ; swrl:argument2 <urn:swrl:var#s> ] ;
        rdf:rest [ a swrl:AtomList ;
          rdf:first [ a swrl:ClassAtom ; swrl:classPredicate arto:UserStory ; swrl:argument1 <urn:swrl:var#s> ] ;
          rdf:rest rdf:nil ] ] ] ;
  swrl:head [ a swrl:AtomList ;
      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate arto:hasTraceLink ; swrl:argument1 <urn:swrl:var#s> ; swrl:argument2 <urn:swrl:var#tc> ] ;
      rdf:rest rdf:nil ]
] .

# R2b
[ a swrl:Imp ;
  rdfs:label "R2b"@en ;
  rdfs:comment "TestCase(?tc) ^ verifies(?tc, ?b) ^ Bug(?b) -> hasTraceLink(?b, ?tc)"@en ;
  swrl:body [ a swrl:AtomList ;
      rdf:first [ a swrl:ClassAtom ; swrl:classPredicate arto:TestCase ; swrl:argument1 <urn:swrl:var#tc> ] ;
      rdf:rest [ a swrl:AtomList ;
        rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate arto:verifies ; swrl:argument1 <urn:swrl:var#tc> ; swrl:argument2 <urn:swrl:var#b> ] ;
        rdf:rest [ a swrl:AtomList ;
          rdf:first [ a swrl:ClassAtom ; swrl:classPredicate arto:Bug ; swrl:argument1 <urn:swrl:var#b> ] ;
          rdf:rest rdf:nil ] ] ] ;
  swrl:head [ a swrl:AtomList ;
      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate arto:hasTraceLink ; swrl:argument1 <urn:swrl:var#b> ; swrl:argument2 <urn:swrl:var#tc> ] ;
      rdf:rest rdf:nil ]
] .

