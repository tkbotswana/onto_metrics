    a arto:AssertedLink , arto:BackwardSDLCLink ;
    arto:linkId 1002 ;
    arto:linkName "reportedIn"^^xsd:string ;
    arto:linkDirection "outward"^^xsd:string ;
    arto:isInferred "false"^^xsd:boolean ;
