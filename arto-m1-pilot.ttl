    arto:sdlcLinkDirection "Backward"^^xsd:string ;
    arto:sourcePhase "Maintenance"^^xsd:string ;
    arto:targetPhase "Requirements"^^xsd:string ;
    arto:hasSourceArtefact arto:bug_001 ;
