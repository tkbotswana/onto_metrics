# ═══════════════════════════════════════════════════════════════════════
# REQUIREMENTCANDIDATE PROMOTION DEMONSTRATION (Step 3 supersedes pattern)
# CQ-PROMO — RequirementCandidate → UserStory promotion history
#
# suggestion_002 is accepted (isAccepted = true). ETL responds by
# minting story_004 as a new UserStory individual and linking it back
# via arto:supersedes — suggestion_002 itself is NOT reclassified: its
# type, isAccepted flag, and any pre-acceptance trace links remain
# exactly as asserted, giving a permanent, queryable acceptance record.
# This is the adopted promotion mechanism; see the rdfs:comment on
# arto:isAccepted (Step 1) and arto:supersedes (Step 3) for why a live
# SWRL reclassification was not used (RequirementCandidate/UserStory
# disjointness would make the ontology inconsistent).
# ═══════════════════════════════════════════════════════════════════════

arto:suggestion_002
    a arto:Suggestion ;
    arto:issueId 502 ;
    arto:issueKey "PROJ-402" ;
    arto:title "Add dark mode to settings panel" ;
    arto:status "Closed" ;
    arto:priority "Medium" ;
    arto:issueType "Suggestion" ;
    arto:projectId 1 ;
    arto:isAccepted "true"^^xsd:boolean .

# story_004 — the promoted UserStory. Note it carries NO rdf:type
# arto:Suggestion or arto:RequirementCandidate; it is a distinct
# individual from suggestion_002, connected only via supersedes.
arto:story_004
    a arto:UserStory ;
    arto:issueId 204 ;
    arto:issueKey "PROJ-104" ;
    arto:title "As a user I can enable dark mode in settings" ;
    arto:status "To Do" ;
    arto:priority "Medium" ;
    arto:issueType "Story" ;
    arto:projectId 1 ;
    arto:storyPoints 3.0 ;
    # CQ-PROMO — promoted UserStory documents its RequirementCandidate origin
    arto:supersedes arto:suggestion_002 .


