@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix arto: <http://www.ub.bw/ontologies/arto#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# ═══════════════════════════════════════════════════════════════════════
# ARTO — M1 Artefact Module
# Pilot Individuals File — ALL smoke test individuals in one place
# University of Botswana · PhD Research · Tshepho Koboyatshwene
#
# Imports: arto-m1-step4.ttl (which imports step3 → step2 → step1)
#
# This file consolidates ALL pilot individuals across Steps 2–4
# into a single authoritative source. This avoids the Protégé
# SPARQL issue where individual re-declarations across imported
# ontologies are silently ignored.
#
# Add to catalog-v001.xml:
#   <uri name="http://www.ub.bw/ontologies/arto/m1-pilot"
#        uri="arto-m1-pilot.ttl"/>
#
# CQs verified by this file:
#   CQ1  — story→task decomposition (hasImplementingTask)
#   CQ2  — bug→story traceability (reportedIn)
#   CQ3a — test coverage (verifies)
#   CQ3b — uncovered stories (MINUS on verifies)
#   CQ5  — orphan detection (story_003 has no trace links)
#   CQ-PROMO — RequirementCandidate promotion history (suggestion_002 → story_004 via supersedes)
#   CQ-D1 — bug fixed in version + affected in version
#   CQ-D2 — story contained in milestone
#   CQ-D3 — design model refines story
#   CQ-D4 — task realizes design model
# ═══════════════════════════════════════════════════════════════════════

<http://www.ub.bw/ontologies/arto/m1-pilot>
    a owl:Ontology ;
    rdfs:label "ARTO M1 Pilot Individuals"@en ;
    rdfs:comment "Consolidated pilot individuals for smoke testing CQ1–CQ5 and CQ-D1–CQ-D4. All cross-step RT assertions declared here to avoid Protégé SPARQL import chain issues."@en ;
    owl:imports <http://www.ub.bw/ontologies/arto/m4-semantic> ;
    owl:versionInfo "5.2.0 — skos:exactMatch declared as object property so pilot exactMatch triples are read as object property assertions (required for SWRL R3); link_005 comment corrected" .


# ═══════════════════════════════════════════════════════════════════════
# PROPERTY DECLARATION (repeated from M4 on purpose)
# Protégé 4.3 (OWL API 3.4.2) read the exactMatch triples in this file
# as annotation assertions, so SWRL Rule R3 could not match them.
# Declaring the property here makes the parse unambiguous.
# ═══════════════════════════════════════════════════════════════════════

skos:exactMatch a owl:ObjectProperty .


