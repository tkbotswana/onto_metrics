# ═══════════════════════════════════════════════════════════════════════
# M2 PILOT INDIVIDUALS — TraceLink smoke tests
# CQ6 — inferred vs asserted link ratio
# CQ7 — link type distribution
# CQ-SDLC1 — full lifecycle chain query
# ═══════════════════════════════════════════════════════════════════════

# AssertedLink — story_001 hasImplementingTask task_001
# from TAWOS Issue_Links (ETL-populated)
arto:link_001
    a arto:AssertedLink , arto:ForwardSDLCLink ;
    arto:linkId 1001 ;
    arto:linkName "hasImplementingTask"^^xsd:string ;
    arto:linkDirection "outward"^^xsd:string ;
    arto:isInferred "false"^^xsd:boolean ;
    arto:confidenceScore 1.0 ;
    arto:assertionMethod "ETL"^^xsd:string ;
    arto:sdlcLinkDirection "Forward"^^xsd:string ;
    arto:sourcePhase "Requirements"^^xsd:string ;
    arto:targetPhase "Implementation"^^xsd:string ;
    arto:hasSourceArtefact arto:story_001 ;
    arto:hasTargetArtefact arto:task_001 ;
    arto:hasLinkType arto:DependencyLink_Type .

# AssertedLink — bug_001 reportedIn story_001
