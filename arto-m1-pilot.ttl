# ═══════════════════════════════════════════════════════════════════════
# M4 PILOT INDIVIDUALS
# TermVariant + SynonymCluster + DriftEvent + skos:exactMatch
# CQ smoke tests:
#   CQ8-1 — synonym detection: two artefacts linked via exactMatch
#   CQ8-2 — synonym cluster contents
#   CQ8-3 — drift event detection
#   CQ8-4 — R3 propagation: trace links shared across synonyms
# ═══════════════════════════════════════════════════════════════════════

# SynonymCluster — authentication/login concept
arto:cluster_auth
    a arto:SynonymCluster ;
    arto:clusterLabel "authentication"^^xsd:string ;
    arto:clusterSize 2 ;
    arto:clusterConfidence 0.92 ;
    arto:resolvedByWordNet "true"^^xsd:boolean ;
    arto:hasVariant arto:variant_login ,
                    arto:variant_auth .

# TermVariant 1 — "login" in Project 1
arto:variant_login
    a arto:TermVariant ;
    arto:canonicalLabel "login"^^xsd:string ;
    arto:rawLabel "Login Story"^^xsd:string ;
    arto:projectSource 1 ;
    arto:termFrequency 47 ;
    arto:termType "UserStory"^^xsd:string ;
    arto:refersToIssue arto:story_001 ;
    arto:inCluster arto:cluster_auth .

# TermVariant 2 — "authentication" in Project 2 (synonym)
arto:variant_auth
    a arto:TermVariant ;
    arto:canonicalLabel "authentication"^^xsd:string ;
    arto:rawLabel "Authentication Story"^^xsd:string ;
    arto:projectSource 2 ;
    arto:termFrequency 31 ;
    arto:termType "UserStory"^^xsd:string ;
    arto:refersToIssue arto:story_equiv ;
    arto:inCluster arto:cluster_auth .

# Equivalent story in Project 2 (synonym of story_001)
arto:story_equiv
    a arto:UserStory ;
    arto:issueId 999 ;
    arto:issueKey "PROJ2-101" ;
    arto:title "Authentication Story" ;
    arto:status "Done" ;
    arto:priority "High" ;
    arto:issueType "Story" ;
    arto:projectId 2 ;
    arto:storyPoints 5.0 .

# skos:exactMatch between story_001 and story_equiv
# This triggers SWRL Rule R3 — trace links of story_001
# propagate to story_equiv
arto:story_001
    skos:exactMatch arto:story_equiv .

# DriftEvent — story_001 title changed from "Login Story"
# to "User Authentication Story" (Change_Log sample)
arto:drift_001
    a arto:DriftEvent ;
    arto:driftEventId 88001 ;
    arto:fromLabel "Login Story"^^xsd:string ;
    arto:toLabel "User Authentication Story"^^xsd:string ;
    arto:driftDate "2023-02-10T09:15:00"^^xsd:dateTime ;
    arto:driftAuthorId 42 ;
    arto:driftIssueId 201 ;
    arto:driftType "TitleDrift"^^xsd:string ;
    arto:affectsArtefact arto:story_001 .

# Link variant_login to the drift event
arto:variant_login
    arto:triggeredDrift arto:drift_001 .

# Second SynonymCluster — bug/defect concept
arto:cluster_defect
    a arto:SynonymCluster ;
    arto:clusterLabel "defect"^^xsd:string ;
    arto:clusterSize 2 ;
    arto:clusterConfidence 0.97 ;
    arto:resolvedByWordNet "true"^^xsd:boolean ;
    arto:hasVariant arto:variant_bug ,
                    arto:variant_defect .

arto:variant_bug
    a arto:TermVariant ;
    arto:canonicalLabel "bug"^^xsd:string ;
    arto:rawLabel "Login fails with special characters"^^xsd:string ;
    arto:projectSource 1 ;
    arto:termFrequency 215570 ;
    arto:termType "Bug"^^xsd:string ;
    arto:refersToIssue arto:bug_001 ;
    arto:inCluster arto:cluster_defect .

arto:variant_defect
    a arto:TermVariant ;
    arto:canonicalLabel "defect"^^xsd:string ;
    arto:rawLabel "Authentication defect special chars"^^xsd:string ;
    arto:projectSource 2 ;
    arto:termFrequency 89 ;
    arto:termType "Bug"^^xsd:string ;
    arto:refersToIssue arto:bug_equiv ;
    arto:inCluster arto:cluster_defect .

# Equivalent bug in Project 2
arto:bug_equiv
    a arto:Bug ;
    arto:issueId 998 ;
    arto:issueKey "PROJ2-301" ;
    arto:title "Authentication defect special chars" ;
    arto:status "Open" ;
    arto:priority "High" ;
    arto:issueType "Bug" ;
    arto:projectId 2 ;
    arto:resolution "Unresolved" .

# skos:exactMatch between bug_001 and bug_equiv
arto:bug_001
    skos:exactMatch arto:bug_equiv .

