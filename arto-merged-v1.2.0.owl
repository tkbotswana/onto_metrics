    <!-- http://www.ub.bw/ontologies/arto#StructuralLink_Type -->

    <owl:NamedIndividual rdf:about="&arto;StructuralLink_Type">
        <rdf:type rdf:resource="&arto;TraceLinkType"/>
        <arto:TraceLinkType_tawosVolume rdf:datatype="&xsd;integer">3261</arto:TraceLinkType_tawosVolume>
        <arto:TraceLinkType_label rdf:datatype="&xsd;string">Structural</arto:TraceLinkType_label>
        <arto:TraceLinkType_properties rdf:datatype="&xsd;string">hasPart · containedIn · hasStory</arto:TraceLinkType_properties>
        <rdfs:comment xml:lang="en">Compositional and containment links. All Issue_Links counts OUTBOUND-only (Oct 2026 audit; each link is stored once INBOUND and once OUTBOUND), mapped through arto_link_type_lookup. hasPart 3,088 (Part 2,116 + Child-Issue 353 + Includes 230 + Containment 186 + Children 80 + Incorporates 74 + Container 47 + Parent Feature 2) + hasStory 173 (Epic Story) = 3,261. hasStory moved here from Dependency in v1.1.0: an Epic containing UserStories is a part-whole relationship, consistent with M1 Step 2. containedIn has no Issue_Links source (the lookup maps Containment to hasPart). Implements the PartOf Content ODP from M1 Step 2. Supersedes the earlier figure of 6,227.</rdfs:comment>
    </owl:NamedIndividual>
    


