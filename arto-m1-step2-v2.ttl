@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix arto: <http://www.ub.bw/ontologies/arto#> .

# ═══════════════════════════════════════════════════════════════════════
# ARTO — M1 Artefact Module
# Middle-out Step 2: Core RT object properties + OrphanArtefact
# University of Botswana · PhD Research · Tshepho Koboyatshwene
#
# Imports: arto-m1-step1-v5.ttl (must be in same folder)
#
# New in this file:
#   PROPERTIES: relatesTo · references · duplicates · blocks ·
#               dependsOn · hasPart · causes · hasImplementingTask ·
#               isImplementedBy · hasStory · reportedIn +
#               all inverse properties
#   CLASS:      arto:OrphanArtefact (cross-cutting classifier)
#
# RT property evidence (OUTBOUND-only, Oct 2026 audit; supersedes earlier estimates that
# double-counted both link directions):
#   relatesTo         ← Relates/Related/Relate/Detail/
#                       Problem-Incident            (37,265 links)
#   references        ← Reference                    (19,914 links)
#   duplicates        ← Duplicate (Cloners excluded)  (29,456 links)
#   blocks            ← Blocks/Blockers/Blocker        (9,169 links)
#   dependsOn         ← Depends/Dependency/Depend      (9,763 links)
#   hasPart           ← Part/Child-Issue/Includes      (3,088 links)
#   causes            ← Cause/Caused (Regression moved
#                       to verifies)                   (1,444 links)
#   hasImplementingTask ← Story→Task/Sub-task, Associative or
#                       Structural link names only        (338 links)
#   hasStory          ← Epic Story only (Parent Feature
#                       moved to hasPart)                (173 links)
#   reportedIn        ← no TAWOS source (pilot only)     (0 links)
#
# Deferred to Step 3 (need TestCase/CodeCommit classes first):
#   verifies · tracesTo · fixes · derives · implements
#
# Excluded (not RT links):
#   Gantt scheduling links · Risk Mitigation · Risk Verification
#
# OrphanArtefact:
#   Formal definition of an orphan: an AgileArtefact with no outgoing
#   and no incoming hasTraceLink. Introduced here because hasTraceLink
#   must exist before orphanhood can be defined.
#   Under the open world assumption HermiT never places an individual
#   in this class: a missing link is unknown, not absent. CQ5 is
#   therefore answered by a closed world SPARQL MINUS query (see R4 in
#   arto-m2-traceability.ttl and Chapter 8, §8.2.4).
#   v1.1.0: definition rewritten as
#     AgileArtefact ⊓ ¬∃hasTraceLink.⊤ ⊓ ¬∃hasTraceLink⁻.⊤
#   Two changes from the earlier form (hasTraceLink exactly 0):
#   (1) OWL 2 DL compliance: the earlier form placed a cardinality
#       restriction on a non-simple property (impacts is transitive
#       and a subproperty of hasTraceLink), which OWL 2 DL forbids.
#   (2) Both directions: the earlier form covered outgoing links only.
#       The definition now also excludes incoming links, matching the
#       direction-inclusive CQ5 query (Chapter 8, §8.2.4).
#
# Protégé setup (IMPORTANT):
#   1. Keep this file and arto-m1-step1-v5.ttl in the SAME folder
#   2. In Protégé: File → Ontology Libraries → Add folder →
#      select the folder containing both files
#   3. File → Open → select THIS file (step2)
#   4. Protégé will auto-resolve the owl:imports to step1
#   5. Reasoner → HermiT → Start reasoner
#   Expected: 14 satisfiable classes, 0 unsatisfiable
#   Verify: Object Properties tab shows all RT properties
#           with correct characteristics
#
# CQ smoke tests (run after loading):
#   CQ1 — story→task decomposition (hasImplementingTask)
#   CQ2 — bug→story traceability (reportedIn in the pilot; any
#         hasTraceLink between Bug and UserStory on TAWOS)
#   CQ5 — orphan detection (closed world SPARQL MINUS query)
# ═══════════════════════════════════════════════════════════════════════

<http://www.ub.bw/ontologies/arto/m1-step2>
    a owl:Ontology ;
    rdfs:label "ARTO M1 Step 2"@en ;
    rdfs:comment "ARTO M1 Artefact Module — Step 2: Core RT object properties and OrphanArtefact classifier."@en ;
    owl:imports <http://www.ub.bw/ontologies/arto/m1-step1> ;
    owl:versionInfo "1.1.0 — step 2: RT object properties + OrphanArtefact. v1.1.0: OrphanArtefact rewritten as AgileArtefact and not (hasTraceLink some Thing) and not (inverse hasTraceLink some Thing), for OWL 2 DL compliance and to cover incoming as well as outgoing links; IrreflexiveProperty restored on duplicates; hasPart rationale corrected. v1.2.0: reportedIn not populated from TAWOS (no explicit source; type-pair assertion would create false traces); hasImplementingTask restricted to Associative and Structural Story→Task/Sub-task links (338)." .


# ═══════════════════════════════════════════════════════════════════════
# CROSS-MODULE BRIDGE PROPERTY
# hasTraceLink — general trace link property
# All specific RT properties are SubPropertyOf hasTraceLink.
# This means every asserted or inferred RT link automatically
# counts as a trace link in CQ5 coverage queries — no redundant
# assertions needed.
# Also used by OrphanArtefact equivalent class definition below.
# ═══════════════════════════════════════════════════════════════════════

arto:hasTraceLink
    a owl:ObjectProperty ;
    rdfs:label "has trace link"@en ;
    rdfs:comment "General trace link superproperty. All specific RT properties are SubPropertyOf hasTraceLink. Used in the definition of OrphanArtefact. Not simple in OWL 2 DL, because the transitive property impacts (M2) is a subproperty, so no cardinality restriction may be placed on it. Bridges M1 and M2 in the full ARTO network."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range arto:AgileArtefact .


# ═══════════════════════════════════════════════════════════════════════
# CLASS: arto:OrphanArtefact
# Cross-cutting classifier — orthogonal to the SDLC hierarchy.
# An individual can be simultaneously a UserStory AND an
# OrphanArtefact — the two classifications are independent.
# Definition:
#   OrphanArtefact ≡ AgileArtefact ⊓ ¬∃hasTraceLink.⊤ ⊓ ¬∃hasTraceLink⁻.⊤
#   i.e. no outgoing and no incoming trace link.
# Under the open world assumption HermiT never infers membership:
# a missing hasTraceLink is unknown, not absent. Orphans are found
# by the closed world SPARQL MINUS query for CQ5 (R4, M2).
# ═══════════════════════════════════════════════════════════════════════

arto:OrphanArtefact
    a owl:Class ;
    rdfs:label "Orphan Artefact"@en ;
    rdfs:comment "Formal definition of an orphan artefact: an AgileArtefact with no outgoing and no incoming hasTraceLink. This matches the direction-inclusive CQ5 query. An individual can be simultaneously a UserStory AND an OrphanArtefact. Under the open world assumption HermiT does not populate this class, because a missing link is unknown rather than absent. CQ5 orphan detection is therefore performed by a closed world SPARQL MINUS query (see R4 in arto-m2-traceability.ttl). Defined with complementOf + someValuesFrom rather than a cardinality restriction, because hasTraceLink is not simple in OWL 2 DL (v1.1.0)."@en ;
    owl:equivalentClass
        [ a owl:Class ;
          owl:intersectionOf
            ( arto:AgileArtefact
              [ a owl:Class ;
                owl:complementOf
                  [ a owl:Restriction ;
                    owl:onProperty arto:hasTraceLink ;
                    owl:someValuesFrom owl:Thing ] ]
              [ a owl:Class ;
                owl:complementOf
                  [ a owl:Restriction ;
                    owl:onProperty [ owl:inverseOf arto:hasTraceLink ] ;
                    owl:someValuesFrom owl:Thing ] ]
            )
        ] .


# ═══════════════════════════════════════════════════════════════════════
# RT OBJECT PROPERTIES
# Ordered by link volume (descending) — highest evidence first.
# All specific RT properties declared SubPropertyOf hasTraceLink
# so every link automatically counts in CQ5 coverage queries.
# Inverse properties inferred by HermiT — not asserted in ETL.
# ═══════════════════════════════════════════════════════════════════════

# ── 1. relatesTo ──────────────────────────────────────────────────────
# Evidence (OUTBOUND-only, Oct 2026 audit): Relates (22,739) + Related (12,754) +
#   Relate (344) + Problem/Incident (380) + Detail (1,048) = 37,265
#   links. Per-pair breakdown not re-verified at this corrected
#   scale; the earlier Query 5 top-pairs figures above are retired
#   rather than carried forward unverified.
# Most general RT property — backbone of the TAWOS link network

arto:relatesTo
    a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:label "relates to"@en ;
    rdfs:comment "General associative RT link between any two artefacts. TAWOS: Relates/Related/Relate, plus the catch-all labels Detail and Problem/Incident (37265 links total, verified via direct OUTBOUND-only COUNT against the live TAWOS database, Oct 2026 audit; supersedes an earlier estimate that double-counted both link directions). Symmetric. Backbone of the TAWOS RT chain — present across all artefact type pairs."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range arto:AgileArtefact ;
    rdfs:subPropertyOf arto:hasTraceLink .


# ── 2. duplicates ─────────────────────────────────────────────────────
# Evidence (OUTBOUND-only, Oct 2026 audit): Duplicate = 29,456 links. Cloners (7,561 rows)
#   deliberately excluded: clone-provenance is administrative
#   content-copy metadata, not a traceability relationship. Per-pair
#   breakdown not re-verified at this corrected scale.
# Irreflexive restored (v1.1.0): duplicates has no subproperties, so it
#   is simple and OWL 2 DL allows Symmetric + Irreflexive together.
#   TAWOS contains no Duplicate link from an issue to itself (verified
#   via direct COUNT, Oct 2026: 0 rows).

arto:duplicates
    a owl:ObjectProperty , owl:SymmetricProperty , owl:IrreflexiveProperty ;
    rdfs:label "duplicates"@en ;
    rdfs:comment "Marks two artefacts as duplicates. TAWOS: Duplicate (29456 links, verified via direct OUTBOUND-only COUNT against the live TAWOS database, Oct 2026 audit). The raw Jira label Cloners (7,561 rows) is deliberately excluded: clone-provenance is administrative content-copy metadata, not a traceability relationship. Symmetric and Irreflexive. Irreflexivity was briefly removed and then restored (v1.1.0): the property is simple, so OWL 2 DL permits it, and TAWOS contains no Duplicate link from an issue to itself (0 rows)."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range arto:AgileArtefact ;
    rdfs:subPropertyOf arto:hasTraceLink .


# ── 3. references ─────────────────────────────────────────────────────
# Evidence (OUTBOUND-only, Oct 2026 audit): Reference = 19,914 links. Per-pair breakdown
#   not re-verified at this corrected scale.

arto:references
    a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:label "references"@en ;
    rdfs:comment "Explicit citation or pointer between artefacts. TAWOS: Reference (19914 links, verified via direct OUTBOUND-only COUNT against the live TAWOS database, Oct 2026 audit). Symmetric."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range arto:AgileArtefact ;
    rdfs:subPropertyOf arto:hasTraceLink .


# ── 4. dependsOn / isDependedOnBy ─────────────────────────────────────
# Evidence (OUTBOUND-only, Oct 2026 audit): Depends (5,103) + Dependency (4,173) +
#   dependent (266) + Depend (169) + Required (52) = 9,763 links.
#   Per-pair breakdown not re-verified at this corrected scale.

arto:dependsOn
    a owl:ObjectProperty , owl:AsymmetricProperty ;
    rdfs:label "depends on"@en ;
    rdfs:comment "Prerequisite dependency between artefacts. TAWOS: Depends/Dependency/Depend/dependent/Required (9763 links, verified via direct OUTBOUND-only COUNT against the live TAWOS database, Oct 2026 audit). Asymmetric."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range arto:AgileArtefact ;
    rdfs:subPropertyOf arto:hasTraceLink .

arto:isDependedOnBy
    a owl:ObjectProperty ;
    rdfs:label "is depended on by"@en ;
    rdfs:comment "Inverse of arto:dependsOn. Inferred by HermiT — not asserted in ETL."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range arto:AgileArtefact ;
    owl:inverseOf arto:dependsOn .


# ── 5. blocks / isBlockedBy ───────────────────────────────────────────
# Evidence (OUTBOUND-only, Oct 2026 audit): Blocks (4,211) + Blockers (3,124) +
#   Blocker (1,428) + Block (396) + Blocked (10) = 9,169 links.
#   Per-pair breakdown not re-verified at this corrected scale.

arto:blocks
    a owl:ObjectProperty , owl:AsymmetricProperty , owl:IrreflexiveProperty ;
    rdfs:label "blocks"@en ;
    rdfs:comment "One artefact prevents progress on another. TAWOS: Blocks/Blockers/Blocker/Block/Blocked (9169 links, verified via direct OUTBOUND-only COUNT against the live TAWOS database, Oct 2026 audit). Asymmetric and Irreflexive."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range arto:AgileArtefact ;
    rdfs:subPropertyOf arto:hasTraceLink .

arto:isBlockedBy
    a owl:ObjectProperty ;
    rdfs:label "is blocked by"@en ;
    rdfs:comment "Inverse of arto:blocks. Inferred by HermiT — not asserted in ETL."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range arto:AgileArtefact ;
    owl:inverseOf arto:blocks .


# ── 6. causes / isCausedBy ────────────────────────────────────────────
# Evidence (OUTBOUND-only, Oct 2026 audit): Cause (1,250) + Caused (194) = 1,444 links.
#   Regression (2,418 links) is reassigned to verifies — it is a
#   test-relationship synonym, not a causation link.
# Domain restricted to Bug — all causation links originate
# from Bug individuals in TAWOS

arto:causes
    a owl:ObjectProperty , owl:AsymmetricProperty , owl:IrreflexiveProperty ;
    rdfs:label "causes"@en ;
    rdfs:comment "A Bug causes or introduces another artefact. TAWOS: Cause/Caused (1444 links, verified via direct OUTBOUND-only COUNT against the live TAWOS database, Oct 2026 audit). The raw Jira label Regression is reassigned to verifies (Oct 2026) — it is a test-relationship synonym, not a causation link; the figure above excludes it. Asymmetric and Irreflexive. Domain restricted to Bug — all causation links in TAWOS originate from Bug individuals."@en ;
    rdfs:domain arto:Bug ;
    rdfs:range arto:AgileArtefact ;
    rdfs:subPropertyOf arto:hasTraceLink .

arto:isCausedBy
    a owl:ObjectProperty ;
    rdfs:label "is caused by"@en ;
    rdfs:comment "Inverse of arto:causes. Inferred by HermiT — not asserted in ETL."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range arto:Bug ;
    owl:inverseOf arto:causes .


# ── 7. hasPart / isPartOf ─────────────────────────────────────────────
# Evidence (OUTBOUND-only, Oct 2026 audit): Part (2,116) + Containment (186) +
#   Container (47) + Children (80) + Child-Issue (353) +
#   Includes (230) + Incorporates (74) + Parent Feature (2) = 3,088
#   links. None of the 186 Containment-named rows target a
#   Milestone-typed Version (see containedIn in Step 4).
# NOT SubPropertyOf relatesTo — removed for a semantic reason.
# relatesTo is Symmetric, so the axiom would make every part also
# relate to its whole in both directions, hiding the direction of
# composition. (Not an OWL 2 DL simplicity issue: hasPart is not
# transitive, so it is simple either way.)
# Implements PartOf Content ODP from Step 1 design

arto:hasPart
    a owl:ObjectProperty , owl:AsymmetricProperty , owl:IrreflexiveProperty ;
    rdfs:label "has part"@en ;
    rdfs:comment "Compositional containment — one artefact contains another. TAWOS: Part/Child-Issue/Children/Includes/Containment/Container/Incorporates (3088 links, verified via direct OUTBOUND-only COUNT against the live TAWOS database, Oct 2026 audit; includes all 'Containment'-named rows, none of which target a Milestone-typed Version in this dataset — see containedIn in Step 4 for the distinction). Asymmetric and Irreflexive. Implements PartOf Content ODP. Note: SubPropertyOf hasTraceLink only. SubPropertyOf relatesTo was removed for a semantic reason: relatesTo is Symmetric, so the axiom would make every part also relate to its whole in both directions, hiding the direction of composition. hasPart is not transitive, so it is simple in OWL 2 DL either way."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range arto:AgileArtefact ;
    rdfs:subPropertyOf arto:hasTraceLink .

arto:isPartOf
    a owl:ObjectProperty ;
    rdfs:label "is part of"@en ;
    rdfs:comment "Inverse of arto:hasPart. Inferred by HermiT — not asserted in ETL."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range arto:AgileArtefact ;
    owl:inverseOf arto:hasPart .


# ── 8. reportedIn / hasReportedBug ────────────────────────────────────
# Evidence: NOT populated from TAWOS (v1.2.0 decision, Nov 2026).
#   TAWOS records no explicit "reported in" link. A Bug→Story type-pair
#   query (OUTBOUND, included link names) returns 1,261 links: Relates
#   842, Blocks 239, Duplicate 120, dependency names 27, other 33; only
#   one (Caused) concerns where a bug came from. Asserting reportedIn on
#   all of them would create false traces (a bug "reported in" a story it
#   duplicates or blocks). The earlier figure of 1,342 counted every
#   link name, including names the lookup excludes.
#   CQ2 on TAWOS is answered by any hasTraceLink between Bug and
#   UserStory, either direction: 2,181 links (1,261 Bug→Story + 920
#   Story→Bug). reportedIn is kept for the pilot and for datasets that
#   record where a bug was reported. SWRL R1c therefore fires on the
#   pilot only.
# Domain: Bug — defects are reported against stories

arto:reportedIn
    a owl:ObjectProperty , owl:AsymmetricProperty ;
    rdfs:label "reported in"@en ;
    rdfs:comment "Links a Bug to the UserStory in which it was discovered. Not populated from TAWOS: the dataset records no explicit reported-in link, and its 1,261 Bug→Story links are mostly Relates, Blocks and Duplicate, so asserting reportedIn on them would create false traces. Used in the pilot data and kept for datasets that record this relationship. Asymmetric. Feeds SWRL R1c (CQ4), which therefore fires on the pilot only. On TAWOS, CQ2 is answered by any hasTraceLink between a Bug and a UserStory."@en ;
    rdfs:domain arto:Bug ;
    rdfs:range arto:UserStory ;
    rdfs:subPropertyOf arto:hasTraceLink .

arto:hasReportedBug
    a owl:ObjectProperty ;
    rdfs:label "has reported bug"@en ;
    rdfs:comment "Inverse of arto:reportedIn. Inferred by HermiT — not asserted in ETL."@en ;
    rdfs:domain arto:UserStory ;
    rdfs:range arto:Bug ;
    owl:inverseOf arto:reportedIn .


# ── 9. hasImplementingTask / isImplementedBy ──────────────────────────
# Evidence (v1.2.0, Nov 2026): Story→Task/Sub-task type-pair query,
#   OUTBOUND, included link names: 481 links (Task 400 + Sub-task 81).
#   TAWOS has no parent-issue column, so issue links are the only
#   decomposition source. Breakdown: Associative 323 (Relates 312,
#   Related 7, Reference 3, Problem/Incident 1) · blocking/dependency 86
#   · Duplicate 36 · Issue split 21 · Structural 15 (Container 6,
#   Incorporates 2, Epic Story 7).
#   hasImplementingTask is asserted only on the Associative and
#   Structural links: 338. Duplicate, blocking/dependency and Issue split
#   links are excluded: they do not mean the task implements the story,
#   and are already captured by duplicates, blocks/dependsOn and derives.
#   The earlier figure of 486 asserted the property on every link name.
# Core CQ1 and CQ2 property — central to ARTO RT chain
# Decomposition chain: Epic → UserStory → SprintTask

arto:hasImplementingTask
    a owl:ObjectProperty , owl:AsymmetricProperty ;
    rdfs:label "has implementing task"@en ;
    rdfs:comment "Decomposes a UserStory into SprintTasks. TAWOS: asserted on Story→Task/Sub-task links whose raw name maps to the Associative or Structural cluster (relatesTo, references, supersedes, hasPart, hasStory): 338 links, OUTBOUND-only, Nov 2026. Duplicate, blocking/dependency and Issue split links between the same types (143) are excluded because they do not express implementation. TAWOS has no parent-issue column, so issue links are the only source. Asymmetric. Core CQ1 property; feeds SWRL R1a and R1b. Part of decomposition chain: Epic → UserStory → SprintTask."@en ;
    rdfs:domain arto:UserStory ;
    rdfs:range arto:SprintTask ;
    rdfs:subPropertyOf arto:hasTraceLink .

arto:isImplementedBy
    a owl:ObjectProperty , owl:AsymmetricProperty ;
    rdfs:label "is implemented by"@en ;
    rdfs:comment "Inverse of arto:hasImplementingTask. A SprintTask implements at least one UserStory."@en ;
    rdfs:domain arto:SprintTask ;
    rdfs:range arto:UserStory ;
    owl:inverseOf arto:hasImplementingTask .


# ── 10. hasStory / isStoryOf ──────────────────────────────────────────
# Evidence: Epic Story — 173 links (verified via direct OUTBOUND-only
#   COUNT, Oct 2026 audit; supersedes an earlier estimate that
#   double-counted both link directions and incorrectly folded in
#   Parent Feature, which the finalized mapping assigns to hasPart
#   instead). TraceLinkType cluster membership moved from
#   DependencyLink_Type to StructuralLink_Type (Oct 2026) — this is a
#   compositional relationship, the same semantic category as hasPart,
#   not a prerequisite dependency.
# Sits above hasImplementingTask in decomposition chain

arto:hasStory
    a owl:ObjectProperty , owl:AsymmetricProperty ;
    rdfs:label "has story"@en ;
    rdfs:comment "Links an Epic to its constituent UserStories. TAWOS: Epic Story, 173 links (verified via direct OUTBOUND-only COUNT, Oct 2026 audit; Parent Feature is mapped to hasPart instead, not hasStory, per the finalized raw-link-type mapping). Asymmetric. Clustered under StructuralLink_Type. Sits above hasImplementingTask: Epic → UserStory → SprintTask."@en ;
    rdfs:domain arto:Epic ;
    rdfs:range arto:UserStory ;
    rdfs:subPropertyOf arto:hasTraceLink .

arto:isStoryOf
    a owl:ObjectProperty ;
    rdfs:label "is story of"@en ;
    rdfs:comment "Inverse of arto:hasStory. Inferred by HermiT — not asserted in ETL."@en ;
    rdfs:domain arto:UserStory ;
    rdfs:range arto:Epic ;
    owl:inverseOf arto:hasStory .
