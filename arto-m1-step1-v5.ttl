@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix arto: <http://www.ub.bw/ontologies/arto#> .

# ═══════════════════════════════════════════════════════════════════════
# ARTO — M1 Artefact Module
# Middle-out Step 1 (v5 — DEFINITIVE): SDLC-aligned class hierarchy
# University of Botswana · PhD Research · Tshepho Koboyatshwene
#
# Class hierarchy:
#   arto:AgileArtefact                     (root superclass)
#   ├── arto:RequirementsArtefact          (SDLC: Requirements phase)
#   │   ├── arto:Epic
#   │   ├── arto:UserStory
#   │   └── arto:RequirementCandidate
#   │       ├── arto:Suggestion
#   │       ├── arto:Improvement
#   │       └── arto:NewFeature
#   ├── arto:ImplementationArtefact        (SDLC: Implementation phase)
#   │   └── arto:SprintTask
#   └── arto:DefectArtefact               (SDLC: temporary position —
#       └── arto:Bug                       migrates under
#                                          MaintenanceArtefact Step 5)
#
# SDLC abstract classes introduced per step:
#   Step 1 — RequirementsArtefact · ImplementationArtefact ·
#             DefectArtefact  (only classes with leaf classes now)
#   Step 3 — ImplementationArtefact completed (CodeCommit) ·
#             TestingArtefact (TestCase · TestResult)
#   Step 4 — DesignArtefact · DeploymentArtefact
#   Step 5 — MaintenanceArtefact (DefectArtefact migrates here)
#
# TAWOS Issue.Type mappings (confirmed from live DB query):
#   Epic               → Issue.Type = 'Epic'              (4,157)
#   UserStory          → Issue.Type = 'Story'             (31,394)
#   Suggestion         → Issue.Type = 'Suggestion'        (96,370)
#   Improvement        → Issue.Type = 'Improvement'       (42,691)
#   NewFeature         → Issue.Type = 'New Feature'       (14,239)
#   SprintTask         → Issue.Type IN ('Task','Sub-task',
#                        'Technical task') WHERE
#                        Sprint_ID IS NOT NULL             (7,967)
#   Bug                → Issue.Type = 'Bug'               (215,570)
#
# No UnclassifiedIssue — all TAWOS types receive proper SDLC homes
# across Steps 1–5. Remaining types handled by ETL filtering until
# their step is reached.
#
# Key design decisions:
#   D1 — SDLC abstract intermediate classes generalise ARTO beyond
#        TAWOS — any dataset maps its types to the abstract class
#        rather than a TAWOS-specific leaf class
#   D2 — DefectArtefact sits directly under AgileArtefact now;
#        migrates under MaintenanceArtefact in Step 5 via a single
#        rdfs:subClassOf update — no property or individual rework
#   D3 — RequirementCandidate addresses literature gap G2
#        (pre-acceptance traceability)
#   D4 — RequirementCandidate re-classified to UserStory via SWRL
#        rule in Step 6 when isAccepted = true
#   D5 — Suggestion · Improvement · NewFeature mutually disjoint
#   D6 — SprintTask single flat class; ETL uses issueType data
#        property to preserve Task/Sub-task/Technical task distinction
#        for provenance and M4 drift analysis
#   D7 — SprintTask ETL condition: Sprint_ID IS NOT NULL;
#        sprint-unassigned Task/Sub-task/Technical task filtered
#        out by ETL until Step 5 MaintenanceArtefact is introduced
#   D8 — OrphanArtefact cross-cutting classifier introduced in Step 2
#        once RT properties exist to define orphanhood against
#
# Load into Protégé 5.6:
#   File → Open → select this file
#   Reasoner → HermiT → Start reasoner
#   Expected: 13 satisfiable classes, 0 unsatisfiable
#   Confirm: "Reasoner active" in bottom-right status bar
#   Check inferred hierarchy:
#     Suggestion · Improvement · NewFeature nested under
#     RequirementCandidate → RequirementsArtefact → AgileArtefact
#     SprintTask nested under ImplementationArtefact → AgileArtefact
#     Bug nested under DefectArtefact → AgileArtefact
# ═══════════════════════════════════════════════════════════════════════

<http://www.ub.bw/ontologies/arto>
    a owl:Ontology ;
    rdfs:label "ARTO"@en ;
    rdfs:comment "Agile Requirements Traceability Ontology. University of Botswana PhD Research. Candidate: Tshepho Koboyatshwene."@en ;
    owl:versionInfo "0.6.0 — middle-out step 1 v5: SDLC-aligned hierarchy, no UnclassifiedIssue" .


# ═══════════════════════════════════════════════════════════════════════
# SHARED DATA PROPERTIES
# Domain: arto:AgileArtefact — inherited by ALL classes
# Source: TAWOS Issue table fields present on every issue type
# ═══════════════════════════════════════════════════════════════════════

arto:issueId
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "issue ID"@en ;
    rdfs:comment "TAWOS: Issue.ID (Int). Primary key. Uniquely identifies any AgileArtefact individual."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range xsd:integer .

arto:issueKey
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "issue key"@en ;
    rdfs:comment "TAWOS: Issue.Issue_Key (String). Human-readable Jira key e.g. PROJ-42."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range xsd:string .

arto:title
    a owl:DatatypeProperty ;
    rdfs:label "title"@en ;
    rdfs:comment "TAWOS: Issue.Title (String). Display name of the artefact."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range xsd:string .

arto:status
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "status"@en ;
    rdfs:comment "TAWOS: Issue.Status (String). Workflow state e.g. To Do, In Progress, Done, Closed."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range xsd:string .

arto:priority
    a owl:DatatypeProperty ;
    rdfs:label "priority"@en ;
    rdfs:comment "TAWOS: Issue.Priority (String). Values: Highest, High, Medium, Low, Lowest."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range xsd:string .

arto:createdAt
    a owl:DatatypeProperty ;
    rdfs:label "created at"@en ;
    rdfs:comment "TAWOS: Issue.Creation_Date (DateTime). When this artefact was created."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range xsd:dateTime .

arto:lastUpdated
    a owl:DatatypeProperty ;
    rdfs:label "last updated"@en ;
    rdfs:comment "TAWOS: Issue.Last_Updated (DateTime). Most recent modification timestamp."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range xsd:dateTime .

arto:description
    a owl:DatatypeProperty ;
    rdfs:label "description"@en ;
    rdfs:comment "TAWOS: Issue.Description_Text (Text). Free-text description."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range xsd:string .

arto:issueType
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "issue type"@en ;
    rdfs:comment "TAWOS: Issue.Type (String). Raw TAWOS type string preserved for provenance and M4 drift analysis. ETL routing uses this value to classify individuals into leaf classes."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range xsd:string .

arto:projectId
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project ID"@en ;
    rdfs:comment "TAWOS: Issue.Project_ID (Int). Foreign key to Project table. Identifies which of the 11 TAWOS projects this artefact belongs to."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range xsd:integer .


# ═══════════════════════════════════════════════════════════════════════
# REQUIREMENTSARTEFACT-SPECIFIC DATA PROPERTIES
# ═══════════════════════════════════════════════════════════════════════

arto:requirementSource
    a owl:DatatypeProperty ;
    rdfs:label "requirement source"@en ;
    rdfs:comment "TAWOS: Issue.Reporter_ID (Int). Who raised this requirement — user, product owner, or stakeholder."@en ;
    rdfs:domain arto:RequirementsArtefact ;
    rdfs:range xsd:string .


# ═══════════════════════════════════════════════════════════════════════
# REQUIREMENTCANDIDATE-SPECIFIC DATA PROPERTIES
# ═══════════════════════════════════════════════════════════════════════

arto:isAccepted
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is accepted"@en ;
    rdfs:comment "Tracks whether this RequirementCandidate has been accepted into a sprint. Set to true by ETL when Issue.Sprint_ID IS NOT NULL AND Issue.Status = Done. NOTE: an earlier design (through v3) planned a SWRL rule to reclassify the individual to UserStory in place; this was abandoned because RequirementCandidate and UserStory are owl:disjointWith each other, which a live reclassification would violate under OWL-DL (HermiT would report the ontology inconsistent), and because SWRL is monotonic and cannot retract the original type regardless. isAccepted = true instead triggers an ETL step that mints a new UserStory individual and links it back to this one via arto:supersedes (see arto-m1-step3.ttl), preserving the acceptance decision trail without reclassification."@en ;
    rdfs:domain arto:RequirementCandidate ;
    rdfs:range xsd:boolean .


# ═══════════════════════════════════════════════════════════════════════
# USERSTORY-SPECIFIC DATA PROPERTIES
# ═══════════════════════════════════════════════════════════════════════

arto:storyPoints
    a owl:DatatypeProperty ;
    rdfs:label "story points"@en ;
    rdfs:comment "TAWOS: Issue.Story_Point (Double). Effort estimate. Only populated once a story is sprint-assigned."@en ;
    rdfs:domain arto:UserStory ;
    rdfs:range xsd:decimal .

arto:acceptanceCriteria
    a owl:DatatypeProperty ;
    rdfs:label "acceptance criteria"@en ;
    rdfs:comment "TAWOS: Issue.Description_Code (Text). Conditions for story acceptance."@en ;
    rdfs:domain arto:UserStory ;
    rdfs:range xsd:string .

arto:resolutionDate
    a owl:DatatypeProperty ;
    rdfs:label "resolution date"@en ;
    rdfs:comment "TAWOS: Issue.Resolution_Date (DateTime). When this story was completed."@en ;
    rdfs:domain arto:UserStory ;
    rdfs:range xsd:dateTime .

arto:timeSpent
    a owl:DatatypeProperty ;
    rdfs:label "time spent"@en ;
    rdfs:comment "TAWOS: Issue.Timespent (Double). Actual effort logged."@en ;
    rdfs:domain arto:UserStory ;
    rdfs:range xsd:decimal .


# ═══════════════════════════════════════════════════════════════════════
# SPRINTTASK-SPECIFIC DATA PROPERTIES
# ═══════════════════════════════════════════════════════════════════════

arto:totalEffortMinutes
    a owl:DatatypeProperty ;
    rdfs:label "total effort (minutes)"@en ;
    rdfs:comment "TAWOS: Issue.Total_Effort_Minutes (Double). Total effort logged against this task."@en ;
    rdfs:domain arto:SprintTask ;
    rdfs:range xsd:decimal .

arto:estimationDate
    a owl:DatatypeProperty ;
    rdfs:label "estimation date"@en ;
    rdfs:comment "TAWOS: Issue.Estimation_Date (DateTime). When story points were estimated for this task."@en ;
    rdfs:domain arto:SprintTask ;
    rdfs:range xsd:dateTime .

arto:storyPointChangedAfterEstimation
    a owl:DatatypeProperty ;
    rdfs:label "story point changed after estimation"@en ;
    rdfs:comment "TAWOS: Issue.Story_Point_Changed_After_Estimation (Boolean). Flags scope creep on this task."@en ;
    rdfs:domain arto:SprintTask ;
    rdfs:range xsd:boolean .


# ═══════════════════════════════════════════════════════════════════════
# BUG-SPECIFIC DATA PROPERTIES
# ═══════════════════════════════════════════════════════════════════════

arto:resolution
    a owl:DatatypeProperty ;
    rdfs:label "resolution"@en ;
    rdfs:comment "TAWOS: Issue.Resolution (String). How the bug was resolved e.g. Fixed, Won't Fix, Duplicate."@en ;
    rdfs:domain arto:Bug ;
    rdfs:range xsd:string .

arto:resolutionTimeMinutes
    a owl:DatatypeProperty ;
    rdfs:label "resolution time (minutes)"@en ;
    rdfs:comment "TAWOS: Issue.Resolution_Time_Minute (Double). Time taken to resolve the bug."@en ;
    rdfs:domain arto:Bug ;
    rdfs:range xsd:decimal .

arto:inProgressMinutes
    a owl:DatatypeProperty ;
    rdfs:label "in progress (minutes)"@en ;
    rdfs:comment "TAWOS: Issue.In_Progress_Minutes (Double). Total time the bug spent In Progress."@en ;
    rdfs:domain arto:Bug ;
    rdfs:range xsd:decimal .


# ═══════════════════════════════════════════════════════════════════════
# CLASS: arto:AgileArtefact
# Root superclass — scopes all shared data properties.
# owl:hasKey on issueId ensures every individual is uniquely
# identified across all 11 TAWOS projects.
# ═══════════════════════════════════════════════════════════════════════

arto:AgileArtefact
    a owl:Class ;
    rdfs:label "Agile Artefact"@en ;
    rdfs:comment "Root superclass for all ARTO artefact classes. Scopes shared TAWOS Issue-table data properties. Generalises across all six SDLC phases via abstract intermediate classes introduced in Steps 1–5."@en ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:issueId ;
          owl:cardinality 1 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:issueKey ;
          owl:cardinality 1 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:title ;
          owl:minCardinality 1 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:status ;
          owl:cardinality 1 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:issueType ;
          owl:cardinality 1 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:projectId ;
          owl:cardinality 1 ] ;

    owl:hasKey ( arto:issueId ) .


# ═══════════════════════════════════════════════════════════════════════
# SDLC ABSTRACT CLASS 1: arto:RequirementsArtefact
# SDLC Phase: Requirements
# Leaf classes in Step 1: Epic · UserStory · RequirementCandidate
#                          (+ Suggestion · Improvement · NewFeature)
# Generalisation: any dataset's requirement-level artefacts
#                 (e.g. UseCase, UserRequirement, ProductBacklogItem)
#                 subclass here for non-TAWOS deployments
# ═══════════════════════════════════════════════════════════════════════

arto:RequirementsArtefact
    a owl:Class ;
    rdfs:label "Requirements Artefact"@en ;
    rdfs:comment "Abstract SDLC Requirements phase class. Groups all requirement-level artefacts. Generalisation point for non-TAWOS datasets — external requirement types subclass here rather than at leaf level. Leaf classes in Step 1: Epic, UserStory, RequirementCandidate and its subclasses."@en ;
    rdfs:subClassOf arto:AgileArtefact ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:requirementSource ;
          owl:minCardinality 0 ] ;

    owl:disjointWith arto:ImplementationArtefact ;
    owl:disjointWith arto:DefectArtefact .


# ═══════════════════════════════════════════════════════════════════════
# SDLC ABSTRACT CLASS 2: arto:ImplementationArtefact
# SDLC Phase: Implementation
# Leaf classes in Step 1: SprintTask
# Leaf classes in Step 3: CodeCommit (after Repository investigation)
# Generalisation: any dataset's implementation-level artefacts
#                 (e.g. PullRequest, Branch, Commit, ChangeSet)
#                 subclass here for non-TAWOS deployments
# ═══════════════════════════════════════════════════════════════════════

arto:ImplementationArtefact
    a owl:Class ;
    rdfs:label "Implementation Artefact"@en ;
    rdfs:comment "Abstract SDLC Implementation phase class. Groups all implementation-level artefacts. Completed in Step 3 with CodeCommit. Generalisation point for non-TAWOS datasets — PullRequest, Branch, ChangeSet subclass here. Leaf classes in Step 1: SprintTask."@en ;
    rdfs:subClassOf arto:AgileArtefact ;

    owl:disjointWith arto:RequirementsArtefact ;
    owl:disjointWith arto:DefectArtefact .


# ═══════════════════════════════════════════════════════════════════════
# SDLC ABSTRACT CLASS 3: arto:DefectArtefact
# SDLC Phase: Temporary position — migrates under
#             MaintenanceArtefact in Step 5
# Leaf classes in Step 1: Bug
# Generalisation: any dataset's defect-level artefacts
#                 (e.g. Defect, Issue, Fault, Error)
#                 subclass here for non-TAWOS deployments
# ═══════════════════════════════════════════════════════════════════════

arto:DefectArtefact
    a owl:Class ;
    rdfs:label "Defect Artefact"@en ;
    rdfs:comment "Abstract defect phase class. Declared here as a named class — rdfs:subClassOf declared in Step 5 where DefectArtefact migrates under MaintenanceArtefact. Generalisation point for non-TAWOS datasets — Defect, Fault, Error subclass here. Leaf classes in Step 1: Bug."@en ;

    owl:disjointWith arto:RequirementsArtefact ;
    owl:disjointWith arto:ImplementationArtefact .


# ═══════════════════════════════════════════════════════════════════════
# CLASS: arto:Epic
# SDLC: RequirementsArtefact → Epic
# TAWOS: Issue.Type = 'Epic' (4,157 individuals)
# ═══════════════════════════════════════════════════════════════════════

arto:Epic
    a owl:Class ;
    rdfs:label "Epic"@en ;
    rdfs:comment "A large body of work decomposed into UserStories or RequirementCandidates. TAWOS: Issue.Type = Epic (4,157). Sits at the top of the requirements decomposition chain: Epic → UserStory → SprintTask."@en ;
    rdfs:subClassOf arto:RequirementsArtefact ;

    owl:disjointWith arto:UserStory ;
    owl:disjointWith arto:RequirementCandidate .


# ═══════════════════════════════════════════════════════════════════════
# CLASS: arto:UserStory
# SDLC: RequirementsArtefact → UserStory
# TAWOS: Issue.Type = 'Story' (31,394 individuals)
# Central node of the ARTO RT chain — all CQ1–CQ7 pass through here.
# ═══════════════════════════════════════════════════════════════════════

arto:UserStory
    a owl:Class ;
    rdfs:label "User Story"@en ;
    rdfs:comment "A committed, sprint-assigned requirement expressed from a user perspective. TAWOS: Issue.Type = Story (31,394). Central RT chain node — CQ1–CQ7 all reference UserStory directly or transitively. Deliberately kept owl:disjointWith RequirementCandidate — see arto:isAccepted for why. Accepted RequirementCandidates are represented as new UserStory individuals connected back via arto:supersedes, not by reclassifying the original individual."@en ;
    rdfs:subClassOf arto:RequirementsArtefact ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:storyPoints ;
          owl:minCardinality 0 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:acceptanceCriteria ;
          owl:minCardinality 0 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:resolutionDate ;
          owl:minCardinality 0 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:timeSpent ;
          owl:minCardinality 0 ] ;

    owl:disjointWith arto:Epic ;
    owl:disjointWith arto:RequirementCandidate .


# ═══════════════════════════════════════════════════════════════════════
# CLASS: arto:RequirementCandidate
# SDLC: RequirementsArtefact → RequirementCandidate
# Intermediate class for pre-acceptance requirement types.
# Addresses literature gap G2 (pre-acceptance traceability).
# ═══════════════════════════════════════════════════════════════════════

arto:RequirementCandidate
    a owl:Class ;
    rdfs:label "Requirement Candidate"@en ;
    rdfs:comment "A proposed requirement not yet accepted into a sprint. Intermediate class grouping Suggestion, Improvement, and NewFeature. Addresses literature gap G2 (pre-acceptance traceability). When isAccepted = true, ETL mints a new UserStory individual linked back to this one via arto:supersedes (Step 3); the original individual keeps its RequirementCandidate typing permanently as an immutable acceptance record, since RequirementCandidate is owl:disjointWith UserStory."@en ;
    rdfs:subClassOf arto:RequirementsArtefact ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:isAccepted ;
          owl:cardinality 1 ] ;

    owl:disjointWith arto:Epic ;
    owl:disjointWith arto:UserStory .


# ═══════════════════════════════════════════════════════════════════════
# CLASS: arto:Suggestion
# SDLC: RequirementsArtefact → RequirementCandidate → Suggestion
# TAWOS: Issue.Type = 'Suggestion' (96,370 individuals)
# ═══════════════════════════════════════════════════════════════════════

arto:Suggestion
    a owl:Class ;
    rdfs:label "Suggestion"@en ;
    rdfs:comment "A user-submitted idea not yet formally accepted as a requirement. TAWOS: Issue.Type = Suggestion (96,370). Largest RequirementCandidate subtype in TAWOS."@en ;
    rdfs:subClassOf arto:RequirementCandidate ;

    owl:disjointWith arto:Improvement ;
    owl:disjointWith arto:NewFeature .


# ═══════════════════════════════════════════════════════════════════════
# CLASS: arto:Improvement
# SDLC: RequirementsArtefact → RequirementCandidate → Improvement
# TAWOS: Issue.Type = 'Improvement' (42,691 individuals)
# ═══════════════════════════════════════════════════════════════════════

arto:Improvement
    a owl:Class ;
    rdfs:label "Improvement"@en ;
    rdfs:comment "A proposed enhancement to existing functionality, not yet sprint-accepted. TAWOS: Issue.Type = Improvement (42,691)."@en ;
    rdfs:subClassOf arto:RequirementCandidate ;

    owl:disjointWith arto:Suggestion ;
    owl:disjointWith arto:NewFeature .


# ═══════════════════════════════════════════════════════════════════════
# CLASS: arto:NewFeature
# SDLC: RequirementsArtefact → RequirementCandidate → NewFeature
# TAWOS: Issue.Type = 'New Feature' (14,239 individuals)
# ═══════════════════════════════════════════════════════════════════════

arto:NewFeature
    a owl:Class ;
    rdfs:label "New Feature"@en ;
    rdfs:comment "A net-new capability request not yet sprint-accepted. TAWOS: Issue.Type = New Feature (14,239)."@en ;
    rdfs:subClassOf arto:RequirementCandidate ;

    owl:disjointWith arto:Suggestion ;
    owl:disjointWith arto:Improvement .


# ═══════════════════════════════════════════════════════════════════════
# CLASS: arto:SprintTask
# SDLC: ImplementationArtefact → SprintTask
# TAWOS: Issue.Type IN ('Task','Sub-task','Technical task')
#        WHERE Issue.Sprint_ID IS NOT NULL (7,967 total)
# ═══════════════════════════════════════════════════════════════════════

arto:SprintTask
    a owl:Class ;
    rdfs:label "Sprint Task"@en ;
    rdfs:comment "A unit of implementation work assigned to a sprint, decomposed from a UserStory. TAWOS: Issue.Type IN (Task, Sub-task, Technical task) WHERE Sprint_ID IS NOT NULL (7,967 total). Raw type preserved in arto:issueType for provenance and M4 drift analysis. Sprint-unassigned instances filtered by ETL until Step 5."@en ;
    rdfs:subClassOf arto:ImplementationArtefact ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:totalEffortMinutes ;
          owl:minCardinality 0 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:estimationDate ;
          owl:minCardinality 0 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:storyPointChangedAfterEstimation ;
          owl:minCardinality 0 ] .


# ═══════════════════════════════════════════════════════════════════════
# CLASS: arto:Bug
# SDLC: DefectArtefact → Bug
# TAWOS: Issue.Type = 'Bug' (215,570 individuals)
# Dominant artefact type in TAWOS — nearly 7x larger than Story.
# ═══════════════════════════════════════════════════════════════════════

arto:Bug
    a owl:Class ;
    rdfs:label "Bug"@en ;
    rdfs:comment "A defect discovered during or after implementation. TAWOS: Issue.Type = Bug (215,570) — dominant artefact type, nearly 7x larger than Story. Participates actively in RT chain via causes, reportedIn, and relatesTo properties. Migrates under MaintenanceArtefact in Step 5."@en ;
    rdfs:subClassOf arto:DefectArtefact ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:resolution ;
          owl:minCardinality 0 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:resolutionTimeMinutes ;
          owl:minCardinality 0 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:inProgressMinutes ;
          owl:minCardinality 0 ] .

