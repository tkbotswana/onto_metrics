@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix arto: <http://www.ub.bw/ontologies/arto#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .

# ═══════════════════════════════════════════════════════════════════════
# ARTO — M4 Semantic Resolution Module
# University of Botswana · PhD Research · Tshepho Koboyatshwene
#
# Imports: arto-m3-sprint.ttl (full chain M1→M2→M3)
#
# This module provides:
#   1. TermVariant class — terminological variant of an artefact
#   2. SynonymCluster class — group of equivalent TermVariants
#   3. DriftEvent class — terminological change detected in TAWOS
#   4. SKOS mappings: skos:exactMatch · skos:closeMatch
#   5. SWRL Rule R3 — cross-sprint semantic equivalence propagation
#   6. Expanded SKOS synonym declarations beyond Step 5 preview
#
# TAWOS grounding:
#   TermVariant: Issue.Title variations across 39 projects
#   SynonymCluster: grouped by semantic similarity
#   DriftEvent: Change_Log WHERE Field = 'summary' (lightweight)
#     Table structure: ID · Field · From_Value · To_Value ·
#     From_String · To_String · Change_Type · Creation_Date ·
#     Author_ID · Issue_ID
#     ETL approach: sample 1,000 summary changes per project
#     avoiding full table scan (timeout at 30s confirmed)
#     From_String = old title · To_String = new title
#     Creation_Date = when drift occurred
#   Additional DriftEvent source: Issue_Links.Name values that
#     do not map cleanly to any TraceLinkType cluster = drift signal
#
# Change_Log full integration:
#   Deferred as future work — full scan produces millions of rows
#   causing MySQL timeout. Future ETL: CREATE INDEX ON Field;
#   then SELECT * WHERE Field = 'summary' LIMIT 1000 per project.
#
# SKOS properties used:
#   skos:exactMatch — strict synonym (same concept, different label)
#   skos:closeMatch — approximate synonym (related but not identical)
#   skos:broadMatch/narrowMatch NOT used — require manual curation
#                                          not computable from TAWOS
#
# SWRL Rule R3 — Cross-sprint Semantic Equivalence Propagation (CQ8):
#   Three sub-rules, encoded as swrl:Imp at the end of this file so
#   they load into Protégé's Rules view automatically:
#   R3a  exactMatch(?v1,?v2) ^ hasTraceLink(?v1,?l) -> hasTraceLink(?v2,?l)
#   R3b  exactMatch(?v1,?v2) ^ hasTraceLink(?v2,?l) -> hasTraceLink(?v1,?l)
#   R3c  exactMatch(?v1,?v2) ^ impacts(?v1,?t)      -> impacts(?v2,?t)
#   (each body also requires AgileArtefact(?v1) ^ AgileArtefact(?v2))
#
# v1.1.0 changes:
#   - skos:exactMatch and skos:closeMatch declared as object
#     properties. Undeclared, Protégé read them as annotation
#     properties, which SWRL rules cannot use.
#   - SKOS is NOT imported and exactMatch is NOT declared symmetric.
#     R3b therefore supplies the backward direction; it is required,
#     not a safety duplicate.
#   - R3a, R3b, R3c added as executable swrl:Imp rules (previously
#     documented in rdfs:comment only and never loaded).
#
# CQs covered:
#   CQ8 — synonym resolution: two artefacts with exactMatch
#          share trace links after R3 fires
#
# Add to catalog-v001.xml:
#   <uri name="http://www.ub.bw/ontologies/arto/m4-semantic"
#        uri="arto-m4-semantic.ttl"/>
# ═══════════════════════════════════════════════════════════════════════

<http://www.ub.bw/ontologies/arto/m4-semantic>
    a owl:Ontology ;
    rdfs:label "ARTO M4 Semantic Resolution Module"@en ;
    rdfs:comment "ARTO M4 Semantic Resolution Module — TermVariant, SynonymCluster, DriftEvent, SKOS synonym mappings, and SWRL Rule R3 for cross-sprint semantic equivalence propagation (CQ8)."@en ;
    owl:imports <http://www.ub.bw/ontologies/arto/m3-sprint> ;
    owl:versionInfo "1.1.0 — M4: TermVariant + SynonymCluster + DriftEvent + SKOS (exactMatch/closeMatch as object properties) + executable R3a/R3b/R3c" .


# ═══════════════════════════════════════════════════════════════════════
# TERMVARIANT DATA PROPERTIES
# ═══════════════════════════════════════════════════════════════════════

arto:canonicalLabel
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "canonical label"@en ;
    rdfs:comment "The normalised, canonical form of this term variant. ETL: derived from Issue.Title by lowercasing, removing punctuation, and stemming. Used as the primary matching key for synonym detection across projects."@en ;
    rdfs:domain arto:TermVariant ;
    rdfs:range xsd:string .

arto:rawLabel
    a owl:DatatypeProperty ;
    rdfs:label "raw label"@en ;
    rdfs:comment "TAWOS: Issue.Title (String). The original, unmodified title string as it appears in TAWOS. Preserved for provenance and M4 drift analysis. Multiple raw labels may share the same canonical label."@en ;
    rdfs:domain arto:TermVariant ;
    rdfs:range xsd:string .

arto:projectSource
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project source"@en ;
    rdfs:comment "TAWOS: Issue.Project_ID (Int). Which of the 39 TAWOS projects this TermVariant originates from. Enables cross-project synonym detection — same canonical label appearing in multiple projects signals a synonym cluster."@en ;
    rdfs:domain arto:TermVariant ;
    rdfs:range xsd:integer .

arto:termFrequency
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "term frequency"@en ;
    rdfs:comment "How many times this term label appears in TAWOS across all issues. ETL: COUNT(Issue WHERE Title LIKE canonicalLabel). Higher frequency terms are more reliable synonym anchors."@en ;
    rdfs:domain arto:TermVariant ;
    rdfs:range xsd:integer .

arto:termType
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "term type"@en ;
    rdfs:comment "The ARTO class this TermVariant is associated with. Values: UserStory · Bug · Improvement · Suggestion · SprintTask · Documentation. Scopes synonym resolution to artefacts of the same type."@en ;
    rdfs:domain arto:TermVariant ;
    rdfs:range xsd:string .


# ═══════════════════════════════════════════════════════════════════════
# SYNONYMCLUSTER DATA PROPERTIES
# ═══════════════════════════════════════════════════════════════════════

arto:clusterLabel
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cluster label"@en ;
    rdfs:comment "The canonical concept label this SynonymCluster represents e.g. 'authentication', 'login', 'user-story'. Used as the cluster's identifier for CQ8 resolution queries."@en ;
    rdfs:domain arto:SynonymCluster ;
    rdfs:range xsd:string .

arto:clusterSize
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cluster size"@en ;
    rdfs:comment "Number of TermVariant individuals in this SynonymCluster. Minimum 2 — a cluster with one term is not a synonym cluster. Larger clusters indicate higher terminological diversity across TAWOS projects."@en ;
    rdfs:domain arto:SynonymCluster ;
    rdfs:range xsd:integer .

arto:clusterConfidence
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cluster confidence"@en ;
    rdfs:comment "Confidence score for this synonym cluster. Range 0.0–1.0. Computed by ETL from term co-occurrence frequency across projects. Higher values indicate more reliable synonymy."@en ;
    rdfs:domain arto:SynonymCluster ;
    rdfs:range xsd:decimal .

arto:resolvedByWordNet
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "resolved by WordNet"@en ;
    rdfs:comment "Whether this synonym cluster was validated against WordNet synonym sets. True = WordNet confirms synonymy · False = TAWOS co-occurrence only. WordNet + Agile glossaries were planned as S4 conversion sources in Parts 3–4."@en ;
    rdfs:domain arto:SynonymCluster ;
    rdfs:range xsd:boolean .


# ═══════════════════════════════════════════════════════════════════════
# DRIFTEVENT DATA PROPERTIES
# Source: Change_Log WHERE Field = 'summary' (lightweight sample)
# Table: ID · Field · From_Value · To_Value · From_String ·
#        To_String · Change_Type · Creation_Date · Author_ID · Issue_ID
# ═══════════════════════════════════════════════════════════════════════

arto:driftEventId
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "drift event ID"@en ;
    rdfs:comment "TAWOS: Change_Log.ID (Int). Primary key of the Change_Log row that triggered this DriftEvent."@en ;
    rdfs:domain arto:DriftEvent ;
    rdfs:range xsd:integer .

arto:fromLabel
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "from label"@en ;
    rdfs:comment "TAWOS: Change_Log.From_String (Text). The original title before the drift occurred. Preserved as the pre-drift term variant."@en ;
    rdfs:domain arto:DriftEvent ;
    rdfs:range xsd:string .

arto:toLabel
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to label"@en ;
    rdfs:comment "TAWOS: Change_Log.To_String (Text). The new title after the drift occurred. The post-drift term variant."@en ;
    rdfs:domain arto:DriftEvent ;
    rdfs:range xsd:string .

arto:driftDate
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "drift date"@en ;
    rdfs:comment "TAWOS: Change_Log.Creation_Date (DateTime). When this terminological change occurred. Enables temporal drift analysis — which sprint did the terminology change in?"@en ;
    rdfs:domain arto:DriftEvent ;
    rdfs:range xsd:dateTime .

arto:driftAuthorId
    a owl:DatatypeProperty ;
    rdfs:label "drift author ID"@en ;
    rdfs:comment "TAWOS: Change_Log.Author_ID (Int). Who made the terminological change. Foreign key to User table."@en ;
    rdfs:domain arto:DriftEvent ;
    rdfs:range xsd:integer .

arto:driftIssueId
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "drift issue ID"@en ;
    rdfs:comment "TAWOS: Change_Log.Issue_ID (Int). The Issue whose title changed. Foreign key to Issue table — links DriftEvent back to the affected AgileArtefact."@en ;
    rdfs:domain arto:DriftEvent ;
    rdfs:range xsd:integer .

arto:driftType
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "drift type"@en ;
    rdfs:comment "Classification of this drift event. Values: TitleDrift (Field=summary change) · LinkNameDrift (Issue_Links.Name does not map to TraceLinkType cluster) · StatusDrift (Field=status change affecting traceability). Primary source: TitleDrift from Change_Log. Secondary: LinkNameDrift from ETL mismatch detection."@en ;
    rdfs:domain arto:DriftEvent ;
    rdfs:range xsd:string .


# ═══════════════════════════════════════════════════════════════════════
# M4 OBJECT PROPERTIES
# ═══════════════════════════════════════════════════════════════════════

arto:hasVariant
    a owl:ObjectProperty ;
    rdfs:label "has variant"@en ;
    rdfs:comment "Links a SynonymCluster to its constituent TermVariant individuals. One-to-many — a cluster contains at least 2 variants. Core M4 property enabling CQ8 synonym resolution."@en ;
    rdfs:domain arto:SynonymCluster ;
    rdfs:range arto:TermVariant .

arto:inCluster
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "in cluster"@en ;
    rdfs:comment "Inverse of arto:hasVariant. Each TermVariant belongs to exactly one SynonymCluster. Functional."@en ;
    rdfs:domain arto:TermVariant ;
    rdfs:range arto:SynonymCluster ;
    owl:inverseOf arto:hasVariant .

arto:refersToIssue
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "refers to issue"@en ;
    rdfs:comment "Links a TermVariant to the AgileArtefact individual it labels. Functional — each TermVariant labels exactly one AgileArtefact. Core M4-M1 bridge: TermVariant(M4) → AgileArtefact(M1)."@en ;
    rdfs:domain arto:TermVariant ;
    rdfs:range arto:AgileArtefact .

arto:hasTermVariant
    a owl:ObjectProperty ;
    rdfs:label "has term variant"@en ;
    rdfs:comment "Inverse of arto:refersToIssue. An AgileArtefact can have multiple TermVariant labels across projects."@en ;
    rdfs:domain arto:AgileArtefact ;
    rdfs:range arto:TermVariant ;
    owl:inverseOf arto:refersToIssue .

arto:triggeredDrift
    a owl:ObjectProperty ;
    rdfs:label "triggered drift"@en ;
    rdfs:comment "Links a TermVariant to DriftEvent individuals it participated in. A TermVariant triggers a drift when its rawLabel changes (from=old variant, to=new variant)."@en ;
    rdfs:domain arto:TermVariant ;
    rdfs:range arto:DriftEvent .

arto:affectsArtefact
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "affects artefact"@en ;
    rdfs:comment "Links a DriftEvent to the AgileArtefact whose title changed. Functional — each DriftEvent affects exactly one AgileArtefact. TAWOS: Change_Log.Issue_ID → AgileArtefact individual."@en ;
    rdfs:domain arto:DriftEvent ;
    rdfs:range arto:AgileArtefact .


# ═══════════════════════════════════════════════════════════════════════
# SKOS MAPPING PROPERTIES — declared locally (SKOS is not imported)
# Without these declarations Protégé treats both as annotation
# properties, and SWRL Rule R3 cannot use skos:exactMatch.
# No characteristics are declared: symmetry and transitivity from the
# SKOS Reference are deliberately not asserted. R3b supplies the
# backward direction that symmetry would otherwise give.
# Class-level mappings below (e.g. Improvement exactMatch
# EnhancementRequest) use OWL 2 punning: the class IRI is also read
# as an individual. This is legal in OWL 2 DL. Those punned
# individuals are not AgileArtefact members, so R3 never fires on them.
# ═══════════════════════════════════════════════════════════════════════

skos:exactMatch
    a owl:ObjectProperty ;
    rdfs:label "exact match"@en ;
    rdfs:comment "SKOS mapping property, declared locally as an object property so SWRL Rule R3 can use it. Strict synonym: same concept, different label. Not declared symmetric or transitive; R3b supplies the backward direction."@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> .

skos:closeMatch
    a owl:ObjectProperty ;
    rdfs:label "close match"@en ;
    rdfs:comment "SKOS mapping property, declared locally as an object property for consistency with skos:exactMatch. Approximate synonym. Not used by any SWRL rule: close matches do not propagate trace links."@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> .


# ═══════════════════════════════════════════════════════════════════════
# CLASS: arto:TermVariant
# A terminological variant of an artefact label.
# TAWOS: derived from Issue.Title across 39 projects.
# Two TermVariants with the same canonicalLabel but different
# projectSource are candidates for skos:exactMatch.
# ═══════════════════════════════════════════════════════════════════════

arto:TermVariant
    a owl:Class ;
    rdfs:label "Term Variant"@en ;
    rdfs:comment "A terminological variant of an artefact concept label across TAWOS projects. Two TermVariants representing the same concept in different projects are linked via skos:exactMatch, enabling SWRL Rule R3 to propagate trace links across project boundaries. TAWOS: derived from Issue.Title normalisation — lowercased, punctuation-removed, stemmed. Core M4 class contributing to literature gap G2 (narrow scope and rigid structure, Chapter 6): M4 reconciles terminology that differs across projects, so artefacts from different projects can be traced together."@en ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:canonicalLabel ;
          owl:cardinality 1 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:rawLabel ;
          owl:minCardinality 1 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:projectSource ;
          owl:cardinality 1 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:refersToIssue ;
          owl:cardinality 1 ] ;

    owl:hasKey ( arto:canonicalLabel arto:projectSource ) .


# ═══════════════════════════════════════════════════════════════════════
# CLASS: arto:SynonymCluster
# Groups TermVariant individuals that represent the same concept
# across different TAWOS projects.
# Minimum 2 TermVariants required (minCardinality 2 on hasVariant).
# ═══════════════════════════════════════════════════════════════════════

arto:SynonymCluster
    a owl:Class ;
    rdfs:label "Synonym Cluster"@en ;
    rdfs:comment "A group of TermVariant individuals that represent the same concept across different TAWOS projects or within the same project over time. Minimum 2 TermVariants required. When SWRL Rule R3 fires on two artefacts linked via skos:exactMatch through their TermVariants, trace links propagate across the cluster. Implements the skos:ConceptScheme pattern for terminology management."@en ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:clusterLabel ;
          owl:cardinality 1 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:hasVariant ;
          owl:minCardinality 2 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:clusterSize ;
          owl:cardinality 1 ] ;

    owl:hasKey ( arto:clusterLabel ) .


# ═══════════════════════════════════════════════════════════════════════
# CLASS: arto:DriftEvent
# A detected terminological change in TAWOS.
# Primary source: Change_Log WHERE Field = 'summary'
#   (lightweight sample: 1,000 rows per project)
# Secondary source: Issue_Links.Name values not mapping to
#   any TraceLinkType cluster (LinkNameDrift)
# Full Change_Log integration deferred as future work —
# requires MySQL index on Field column to avoid timeout.
# ═══════════════════════════════════════════════════════════════════════

arto:DriftEvent
    a owl:Class ;
    rdfs:label "Drift Event"@en ;
    rdfs:comment "A detected terminological change in TAWOS artefact labels. Primary source: Change_Log WHERE Field = 'summary' — title changes captured via From_String (old label) and To_String (new label) with Creation_Date timestamp. Secondary source: Issue_Links.Name values not mapping to any M2 TraceLinkType cluster (LinkNameDrift). Full Change_Log integration deferred: MySQL full scan timeouts at 30s — future ETL requires CREATE INDEX ON Change_Log(Field). Lightweight ETL: sample 1,000 summary changes per project using LIMIT clause."@en ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:driftEventId ;
          owl:cardinality 1 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:fromLabel ;
          owl:cardinality 1 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:toLabel ;
          owl:cardinality 1 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:driftDate ;
          owl:cardinality 1 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:driftType ;
          owl:cardinality 1 ] ;

    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty arto:affectsArtefact ;
          owl:cardinality 1 ] ;

    owl:hasKey ( arto:driftEventId ) .


# ═══════════════════════════════════════════════════════════════════════
# EXPANDED SKOS SYNONYM MAPPINGS
# Extends the Step 5 preview with full cross-project mappings
# derived from TAWOS Issue.Type analysis and Agile glossaries
#
# skos:exactMatch — same concept, different label (strict synonym)
# skos:closeMatch — related concept, approximate synonym
#
# ETL synonym detection query (lightweight):
#   SELECT i1.Title, i2.Title, COUNT(*) AS co_occurrence
#   FROM Issue_Links il
#   JOIN Issue i1 ON il.Issue_ID = i1.ID
#   JOIN Issue i2 ON il.Target_Issue_ID = i2.ID
#   WHERE il.Name = 'Duplicate'
#   GROUP BY i1.Title, i2.Title
#   HAVING co_occurrence > 5
#   ORDER BY co_occurrence DESC
#   LIMIT 100;
# ═══════════════════════════════════════════════════════════════════════

# ── Issue Type Synonyms (from TAWOS Query 12 + Agile glossaries) ──────

# EnhancementRequest ≡ Improvement (confirmed: both are backlog items
# proposing functional improvements — 3,239 vs 42,691 individuals)
arto:Improvement
    skos:exactMatch
        <http://www.ub.bw/ontologies/arto#EnhancementRequest> .

# TechnicalDebt ≈ Improvement (close but not exact — technical debt
# is deferred improvement work, not a new improvement)
arto:Improvement
    skos:closeMatch
        <http://www.ub.bw/ontologies/arto#TechnicalDebt> .

# SupportRequest ≈ Bug (close — support requests often surface bugs
# not yet formally triaged; confirmed by Query 13: 154 RT links
# between SupportRequest and Bug)
arto:SupportRequest
    skos:closeMatch arto:Bug .

# BuildFailure ≈ Bug (close — build failures frequently introduce
# or expose bugs; Query 13: 43 Duplicate links BuildFailure↔Bug)
arto:BuildFailure
    skos:closeMatch arto:Bug .

# Investigation ≈ ProblemTicket (close — investigations analyse
# systemic issues similar to problem tickets)
arto:ProblemTicket
    skos:closeMatch
        <http://www.ub.bw/ontologies/arto#Investigation> .

# Wish ≈ Suggestion (close — both are informal user requests
# not yet formally accepted; Wish (88) is a low-volume synonym
# for Suggestion (96,370) in TAWOS)
arto:Suggestion
    skos:closeMatch
        <http://www.ub.bw/ontologies/arto#Wish> .

# Question ≈ SupportRequest (close — questions in Jira often
# represent informal support requests)
arto:SupportRequest
    skos:closeMatch
        <http://www.ub.bw/ontologies/arto#Question> .

# ── RT Link Name Synonyms (from TAWOS Query 4) ───────────────────────
# These are TermVariant-level synonyms — different Issue_Links.Name
# values that map to the same TraceLinkType cluster

# "Related" ≡ "Relates" (same AssociativeLink_Type cluster)
# "Relate" ≡ "Relates"
# "Reference" ≡ "Relates" (close — reference is a specific form
# of association)

# ── Cross-project Agile Terminology Synonyms ─────────────────────────
# Derived from Agile framework glossary comparison
# (Scrum · Kanban · SAFe — S4 conversion source)

# UserStory ≡ Story (Scrum terminology — same concept)
# SprintTask ≡ Task (Scrum) ≡ Card (Kanban)
# Sprint ≡ Iteration (SAFe/XP terminology)
# Epic ≡ Feature (SAFe terminology)
# Bug ≡ Defect (formal testing terminology)

arto:Sprint
    skos:exactMatch
        <http://www.ub.bw/ontologies/arto#Iteration> .

arto:Bug
    skos:exactMatch
        <http://www.ub.bw/ontologies/arto#Defect> .

arto:UserStory
    skos:exactMatch
        <http://www.ub.bw/ontologies/arto#Story> .


# ═══════════════════════════════════════════════════════════════════════
# SWRL RULE R3 — Cross-sprint Semantic Equivalence Propagation (CQ8)
# The rules themselves are encoded as swrl:Imp below and load into
# Protégé's Rules view (Window → Views → Ontology views → Rules).
# This named individual keeps the human-readable documentation.
# ═══════════════════════════════════════════════════════════════════════

arto:R3_SemanticEquivalencePropagation_M4
    a owl:NamedIndividual ;
    rdfs:label "R3 — Semantic Equivalence Propagation (M4 full)"@en ;
    rdfs:comment """SWRL Rule R3 — Full implementation in M4 (CQ8)

Rules view syntax (all three are encoded as swrl:Imp in this file):

Rule R3a — Forward propagation:
AgileArtefact(?v1) ^ AgileArtefact(?v2) ^
skos:exactMatch(?v1, ?v2) ^ hasTraceLink(?v1, ?l)
-> hasTraceLink(?v2, ?l)

Rule R3b — Backward propagation (symmetric):
AgileArtefact(?v1) ^ AgileArtefact(?v2) ^
skos:exactMatch(?v1, ?v2) ^ hasTraceLink(?v2, ?l)
-> hasTraceLink(?v1, ?l)

Rule R3c — Impact propagation across synonyms:
AgileArtefact(?v1) ^ AgileArtefact(?v2) ^
skos:exactMatch(?v1, ?v2) ^ impacts(?v1, ?t)
-> impacts(?v2, ?t)

Explanation:
- Fires when two AgileArtefact individuals are declared
  skos:exactMatch (confirmed synonyms)
- Propagates hasTraceLink and impacts assertions bidirectionally
- Example: if story_001 (Project A: 'Login Story') is exactMatch
  story_equiv (Project B: 'Authentication Story'), then all
  trace links of story_001 also apply to story_equiv
- Requires TermVariant individuals with skos:exactMatch assertions
- Creates InferredLink individuals in ETL post-processing:
    assertionMethod = SWRL
    hasLinkType = AssociativeLink_Type
    isInferred = true
    sdlcLinkDirection = Horizontal

CQ8 SPARQL:
SELECT ?v1 ?v2 ?link WHERE {
  ?v1 skos:exactMatch ?v2 .
  ?v1 arto:hasTraceLink ?link .
  ?v2 arto:hasTraceLink ?link .
}

Note: the SKOS Reference makes skos:exactMatch symmetric, but SKOS
is not imported and ARTO does not redeclare symmetry. Pilot data
asserts each exactMatch pair in one direction only, so R3b is
required for links to flow in both directions.

Verification: run HermiT, then inspect story_001 in the
Individuals tab. Inferred hasTraceLink values appear highlighted.
SPARQL in the embedded engine shows asserted triples only, so it
cannot confirm rule output."""@en .


# ═══════════════════════════════════════════════════════════════════════
# SWRL RULE R3 — EXECUTABLE ENCODING (swrl:Imp)
# Variables use Protégé's convention urn:swrl:var#
# ═══════════════════════════════════════════════════════════════════════

<urn:swrl:var#v1> a swrl:Variable .
<urn:swrl:var#v2> a swrl:Variable .
<urn:swrl:var#l>  a swrl:Variable .
<urn:swrl:var#t>  a swrl:Variable .

# R3a — forward propagation of trace links
[ a swrl:Imp ;
  rdfs:label "R3a"@en ;
  rdfs:comment "AgileArtefact(?v1) ^ AgileArtefact(?v2) ^ skos:exactMatch(?v1, ?v2) ^ hasTraceLink(?v1, ?l) -> hasTraceLink(?v2, ?l)"@en ;
  swrl:body [ a swrl:AtomList ;
      rdf:first [ a swrl:ClassAtom ;
                  swrl:classPredicate arto:AgileArtefact ;
                  swrl:argument1 <urn:swrl:var#v1> ] ;
      rdf:rest [ a swrl:AtomList ;
          rdf:first [ a swrl:ClassAtom ;
                      swrl:classPredicate arto:AgileArtefact ;
                      swrl:argument1 <urn:swrl:var#v2> ] ;
          rdf:rest [ a swrl:AtomList ;
              rdf:first [ a swrl:IndividualPropertyAtom ;
                          swrl:propertyPredicate skos:exactMatch ;
                          swrl:argument1 <urn:swrl:var#v1> ;
                          swrl:argument2 <urn:swrl:var#v2> ] ;
              rdf:rest [ a swrl:AtomList ;
                  rdf:first [ a swrl:IndividualPropertyAtom ;
                              swrl:propertyPredicate arto:hasTraceLink ;
                              swrl:argument1 <urn:swrl:var#v1> ;
                              swrl:argument2 <urn:swrl:var#l> ] ;
                  rdf:rest rdf:nil ] ] ] ] ;
  swrl:head [ a swrl:AtomList ;
      rdf:first [ a swrl:IndividualPropertyAtom ;
                  swrl:propertyPredicate arto:hasTraceLink ;
                  swrl:argument1 <urn:swrl:var#v2> ;
                  swrl:argument2 <urn:swrl:var#l> ] ;
      rdf:rest rdf:nil ]
] .

# R3b — backward propagation of trace links (required: no symmetry)
[ a swrl:Imp ;
  rdfs:label "R3b"@en ;
  rdfs:comment "AgileArtefact(?v1) ^ AgileArtefact(?v2) ^ skos:exactMatch(?v1, ?v2) ^ hasTraceLink(?v2, ?l) -> hasTraceLink(?v1, ?l)"@en ;
  swrl:body [ a swrl:AtomList ;
      rdf:first [ a swrl:ClassAtom ;
                  swrl:classPredicate arto:AgileArtefact ;
                  swrl:argument1 <urn:swrl:var#v1> ] ;
      rdf:rest [ a swrl:AtomList ;
          rdf:first [ a swrl:ClassAtom ;
                      swrl:classPredicate arto:AgileArtefact ;
                      swrl:argument1 <urn:swrl:var#v2> ] ;
          rdf:rest [ a swrl:AtomList ;
              rdf:first [ a swrl:IndividualPropertyAtom ;
                          swrl:propertyPredicate skos:exactMatch ;
                          swrl:argument1 <urn:swrl:var#v1> ;
                          swrl:argument2 <urn:swrl:var#v2> ] ;
              rdf:rest [ a swrl:AtomList ;
                  rdf:first [ a swrl:IndividualPropertyAtom ;
                              swrl:propertyPredicate arto:hasTraceLink ;
                              swrl:argument1 <urn:swrl:var#v2> ;
                              swrl:argument2 <urn:swrl:var#l> ] ;
                  rdf:rest rdf:nil ] ] ] ] ;
  swrl:head [ a swrl:AtomList ;
      rdf:first [ a swrl:IndividualPropertyAtom ;
                  swrl:propertyPredicate arto:hasTraceLink ;
                  swrl:argument1 <urn:swrl:var#v1> ;
                  swrl:argument2 <urn:swrl:var#l> ] ;
      rdf:rest rdf:nil ]
] .

# R3c — impact propagation across exact synonyms
[ a swrl:Imp ;
  rdfs:label "R3c"@en ;
  rdfs:comment "AgileArtefact(?v1) ^ AgileArtefact(?v2) ^ skos:exactMatch(?v1, ?v2) ^ impacts(?v1, ?t) -> impacts(?v2, ?t)"@en ;
  swrl:body [ a swrl:AtomList ;
      rdf:first [ a swrl:ClassAtom ;
                  swrl:classPredicate arto:AgileArtefact ;
                  swrl:argument1 <urn:swrl:var#v1> ] ;
      rdf:rest [ a swrl:AtomList ;
          rdf:first [ a swrl:ClassAtom ;
                      swrl:classPredicate arto:AgileArtefact ;
                      swrl:argument1 <urn:swrl:var#v2> ] ;
          rdf:rest [ a swrl:AtomList ;
              rdf:first [ a swrl:IndividualPropertyAtom ;
                          swrl:propertyPredicate skos:exactMatch ;
                          swrl:argument1 <urn:swrl:var#v1> ;
                          swrl:argument2 <urn:swrl:var#v2> ] ;
              rdf:rest [ a swrl:AtomList ;
                  rdf:first [ a swrl:IndividualPropertyAtom ;
                              swrl:propertyPredicate arto:impacts ;
                              swrl:argument1 <urn:swrl:var#v1> ;
                              swrl:argument2 <urn:swrl:var#t> ] ;
                  rdf:rest rdf:nil ] ] ] ] ;
  swrl:head [ a swrl:AtomList ;
      rdf:first [ a swrl:IndividualPropertyAtom ;
                  swrl:propertyPredicate arto:impacts ;
                  swrl:argument1 <urn:swrl:var#v2> ;
                  swrl:argument2 <urn:swrl:var#t> ] ;
      rdf:rest rdf:nil ]
] .

